@page
@model ForgotPasswordModel

@{
    ViewData["Title"] = "Passwort vergessen";
}

<div class="container py-5">

    <div class="text-center mb-5">
        <h1 class="fw-bold display-6">Passwort vergessen?</h1>
        <p class="text-muted fs-5">Geben Sie Ihre E-Mail-Adresse ein, um einen Reset-Link zu erhalten</p>
    </div>

    <div class="row justify-content-center">

        <div class="col-lg-5">

            <div class="card border-0 shadow-lg p-4">

                <form method="post">

                    <div asp-validation-summary="ModelOnly" class="text-danger text-center mb-3"></div>

                    <!-- EMAIL -->
                    <div class="form-floating mb-4">
                        <input asp-for="Input.Email"
                               class="form-control"
                               placeholder="name@example.com" />
                        <label asp-for="Input.Email">E-Mail</label>
                        <span asp-validation-for="Input.Email" class="text-danger small"></span>
                    </div>

                    <!-- BUTTON -->
                    <button type="submit" class="btn btn-primary w-100 btn-lg shadow-sm">
                        Reset-Link senden
                    </button>

                    <!-- BACK -->
                    <div class="text-center mt-4 small">
                        <a asp-page="./Login">
                            Zurück zum Login
                        </a>
                    </div>

                </form>

            </div>

        </div>
    </div>
</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}