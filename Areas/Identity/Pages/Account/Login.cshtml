@page
@model LoginModel

@{
    ViewData["Title"] = "Најава";
}

<style>
    body {
        background: #f6f7f9;
        color: #111;
    }

    h1 {
        font-weight: 600;
        color: #111;
    }

    .text-muted {
        color: #6b7280 !important;
    }

    .card {
        background: #ffffff !important;
        border: 1px solid #eceef2 !important;
        border-radius: 20px !important;
        box-shadow: 0 8px 24px rgba(0,0,0,.04) !important;
    }

    .form-control {
        background: #ffffff;
        border: 1px solid #e2e5ea;
        border-radius: 14px;
    }

        .form-control:focus {
            border-color: #111;
            box-shadow: 0 0 0 3px rgba(0,0,0,.05);
        }

    .btn-primary {
        background: #111 !important;
        border: none !important;
        border-radius: 14px;
        font-weight: 600;
    }

        .btn-primary:hover {
            background: #000 !important;
            transform: translateY(-2px);
            box-shadow: 0 6px 14px rgba(0,0,0,.15);
        }

    .auth-link {
        color: #111;
        text-decoration: none;
        font-weight: 500;
    }

        .auth-link:hover {
            text-decoration: underline;
        }
</style>

<div class="container py-5">

    <div class="text-center mb-4">
        <h1 class="fw-bold display-6">Добредојдовте назад</h1>
        <p class="text-muted fs-5">Најавете се на вашата сметка</p>
    </div>

    <div class="card border-0 shadow-lg p-4 mx-auto" style="max-width:600px">

        <form method="post">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger text-center mb-4"></div>

            <div class="form-floating mb-3">
                <input asp-for="Input.Email"
                       class="form-control"
                       placeholder="email@пример.мк" />
                <label asp-for="Input.Email">Е-пошта</label>
            </div>

            <div class="form-floating mb-3">
                <input asp-for="Input.Password"
                       type="password"
                       class="form-control"
                       placeholder="Лозинка" />
                <label asp-for="Input.Password">Лозинка</label>
            </div>

            <div class="form-check mb-4">
                <input class="form-check-input" asp-for="Input.RememberMe" />
                <label class="form-check-label" asp-for="Input.RememberMe">
                    Запомни ме
                </label>
            </div>

            <button type="submit"
                    class="btn btn-primary w-100 btn-lg mb-3">
                Најави се
            </button>

            <div class="text-center small">
                <a asp-page="./ForgotPassword" class="auth-link d-block mb-2">
                    Ја заборавивте лозинката?
                </a>

                <a asp-page="./Register"
                       asp-route-returnUrl="@Model.ReturnUrl"
                       class="auth-link d-block">
                    Креирај нов профил
                </a>
            </div>

        </form>

    </div>

    @if ((Model.ExternalLogins?.Count ?? 0) > 0)
    {
        <div class="card border-0 shadow-lg p-4 mx-auto mt-4" style="max-width:600px">

            <div class="text-center mb-3 small text-muted">
                Или најавете се со
            </div>

            <form asp-page="./ExternalLogin"
                  asp-route-returnUrl="@Model.ReturnUrl"
                  method="post"
                  class="d-grid gap-2">

                @foreach (var provider in Model.ExternalLogins!)
                {
                    <button type="submit"
                            class="btn btn-outline-secondary"
                            name="provider"
                            value="@provider.Name">
                        @provider.DisplayName
                    </button>
                }

            </form>

        </div>
    }

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}