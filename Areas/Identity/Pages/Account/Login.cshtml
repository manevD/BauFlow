@page
@model LoginModel

@{
    ViewData["Title"] = "Anmelden";
}

<div class="container py-5">

    <div class="text-center mb-5">
        <h1 class="fw-bold display-6">Willkommen zurück</h1>
        <p class="text-muted fs-5">Melden Sie sich in Ihr Konto an</p>
    </div>

    <div class="row justify-content-center">

        <div class="col-lg-5">

            <div class="card border-0 shadow-lg p-4">

                <form method="post">

                    <div asp-validation-summary="ModelOnly" class="text-danger text-center mb-3"></div>

                    <!-- EMAIL -->
                    <div class="form-floating mb-3">
                        <input asp-for="Input.Email"
                               class="form-control"
                               placeholder="name@example.com" />
                        <label asp-for="Input.Email">E-Mail</label>
                        <span asp-validation-for="Input.Email" class="text-danger small"></span>
                    </div>

                    <!-- PASSWORD -->
                    <div class="form-floating mb-3">
                        <input asp-for="Input.Password"
                               class="form-control"
                               placeholder="Passwort" />
                        <label asp-for="Input.Password">Passwort</label>
                        <span asp-validation-for="Input.Password" class="text-danger small"></span>
                    </div>

                    <!-- REMEMBER -->
                    <div class="form-check mb-4">
                        <input class="form-check-input" asp-for="Input.RememberMe" />
                        <label class="form-check-label" asp-for="Input.RememberMe">
                            Angemeldet bleiben
                        </label>
                    </div>

                    <!-- LOGIN BUTTON -->
                    <button type="submit" class="btn btn-primary w-100 btn-lg shadow-sm">
                        Anmelden
                    </button>

                    <!-- LINKS -->
                    <div class="text-center mt-4 small">

                        <a asp-page="./ForgotPassword" class="d-block mb-2">
                            Passwort vergessen?
                        </a>

                        <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="d-block mb-2">
                            Neues Konto erstellen
                        </a>

                    </div>

                </form>

                <!-- EXTERNAL LOGIN -->
                @if ((Model.ExternalLogins?.Count ?? 0) > 0)
                {
                    <hr class="my-4" />

                    <div class="text-center mb-3 text-muted small">
                        Oder anmelden mit
                    </div>

                    <form asp-page="./ExternalLogin"
                          asp-route-returnUrl="@Model.ReturnUrl"
                          method="post"
                          class="d-grid gap-2">

                        @foreach (var provider in Model.ExternalLogins!)
                        {
                            <button type="submit"
                                    class="btn btn-outline-dark"
                                    name="provider"
                                    value="@provider.Name">
                                @provider.DisplayName
                            </button>
                        }

                    </form>
                }

            </div>
        </div>
    </div>
</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}