@page
@model ChangePasswordModel
@{
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<link href="~/css/siteUser.css" rel="stylesheet" />


<partial name="_StatusMessage" for="StatusMessage" />

<div class="col-md-6">

    <div class="profile-card">

        <h3>Промени лозинка</h3>

        <form method="post">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3"></div>

            <div class="form-floating mb-4">
                <input asp-for="Input.OldPassword"
                       type="password"
                       class="form-control"
                       placeholder="Тековна лозинка" />
                <label asp-for="Input.OldPassword">Тековна лозинка</label>
            </div>

            <div class="form-floating mb-3">
                <input asp-for="Input.NewPassword"
                       type="password"
                       class="form-control"
                       placeholder="Нова лозинка" />
                <label asp-for="Input.NewPassword">Нова лозинка</label>
            </div>

            <div class="form-floating mb-4">
                <input asp-for="Input.ConfirmPassword"
                       type="password"
                       class="form-control"
                       placeholder="Потврди лозинка" />
                <label asp-for="Input.ConfirmPassword">Потврди лозинка</label>
            </div>

            <button type="submit"
                    class="btn btn-primary-custom w-100">
                Ажурирај лозинка
            </button>

        </form>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}