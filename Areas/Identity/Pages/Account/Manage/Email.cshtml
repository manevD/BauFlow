@page
@model EmailModel
@{
    ViewData["ActivePage"] = ManageNavPages.Email;
}

<link href="~/css/siteUser.css" rel="stylesheet" />


<partial name="_StatusMessage" for="StatusMessage" />

<div class="col-md-6">

    <div class="profile-card">

        <h3>Промени е-пошта</h3>

        <form id="email-form" method="post">

            <div asp-validation-summary="All"
                 class="text-danger mb-3"
                 role="alert"></div>

            @if (Model.IsEmailConfirmed)
            {
                <div class="form-floating mb-4">
                    <input asp-for="Email"
                           class="form-control"
                           disabled />
                    <label asp-for="Email">Е-пошта</label>
                </div>
            }
            else
            {
                <div class="form-floating mb-2">
                    <input asp-for="Email"
                           class="form-control"
                           disabled />
                    <label asp-for="Email">Е-пошта</label>
                </div>

                <button id="email-verification"
                        type="submit"
                        asp-page-handler="SendVerificationEmail"
                        class="btn btn-link mb-4 p-0">
                    Испрати е-пошта за потврда
                </button>
            }

            <div class="form-floating mb-4">
                <input asp-for="Input.NewEmail"
                       class="form-control"
                       autocomplete="email"
                       aria-required="true"
                       placeholder="Нова е-пошта" />
                <label asp-for="Input.NewEmail">Нова е-пошта</label>
                <span asp-validation-for="Input.NewEmail"
                      class="small text-danger"></span>
            </div>

            <button id="change-email-button"
                    type="submit"
                    asp-page-handler="ChangeEmail"
                    class="btn btn-primary-custom w-100">
                Промени е-пошта
            </button>

        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}