@page
@model IndexModel
@{
    ViewData["ActivePage"] = ManageNavPages.Index;
}

<link href="~/css/siteUser.css" rel="stylesheet" />

<partial name="_StatusMessage" for="StatusMessage" />

    <div class="col-md-6">

        <div class="profile-card">

            <h3>Профил</h3>

            <form id="profile-form" method="post">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-4"
                     role="alert"></div>

                <div class="form-floating mb-4">
                    <input asp-for="Username"
                           class="form-control"
                           placeholder="Корисничко име"
                           disabled />
                    <label asp-for="Username">Корисничко име</label>
                </div>

                <div class="form-floating mb-4">
                    <input asp-for="Input.PhoneNumber"
                           class="form-control"
                           placeholder="Телефон" />
                    <label asp-for="Input.PhoneNumber">Телефон</label>
                    <span asp-validation-for="Input.PhoneNumber"
                          class="small text-danger"></span>
                </div>

                <button id="update-profile-button"
                        type="submit"
                    class="btn btn-primary-custom w-100">
                    Зачувај
                </button>

            </form>

        </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}