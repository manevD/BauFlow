@page
@model PersonalDataModel
@{
    ViewData["Title"] = "Лични податоци";
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}
<link href="~/css/siteUser.css" rel="stylesheet" />

<h3>@ViewData["Title"]</h3>

    <div class="col-md-6">

        <p>
            Вашиот профил содржи лични податоци што ни ги имате доставено.
            На оваа страница можете да ги преземете или избришете овие податоци.
        </p>

        <p>
            <strong>
                Со бришење на овие податоци, вашиот профил ќе биде трајно избришан и нема да може да се врати.
            </strong>
        </p>

        <div style="display:flex; gap:10px; align-items:center;">

            <form id="download-data"
                  asp-page="DownloadPersonalData"
                  method="post">

            <button class="btn btn-primary-custom w-100" type="submit">
                    Преземи
                </button>

            </form>

            <a id="delete"
                   asp-page="DeletePersonalData"
                   class="btn btn-danger">
                Избриши
            </a>

        </div>

    </div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}