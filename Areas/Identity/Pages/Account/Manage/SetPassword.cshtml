@page
@model SetPasswordModel
@{
    ViewData["Title"] = "Постави лозинка";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<h3>Постави лозинка</h3>

<partial name="_StatusMessage" for="StatusMessage" />

<p class="text-info">
    Немате локален профил или лозинка за оваа веб-страница.
    Додадете лозинка за да можете да се најавувате без надворешен (external) логин.
</p>

<div class="row">
    <div class="col-md-6">

        <form id="set-password-form" method="post">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger"
                 role="alert"></div>

            <div class="form-floating mb-3">
                <input asp-for="Input.NewPassword"
                       class="form-control"
                       autocomplete="new-password"
                       placeholder="Внесете нова лозинка" />
                <label asp-for="Input.NewPassword" class="form-label">
                    Нова лозинка
                </label>
                <span asp-validation-for="Input.NewPassword"
                      class="text-danger"></span>
            </div>

            <div class="form-floating mb-3">
                <input asp-for="Input.ConfirmPassword"
                       class="form-control"
                       autocomplete="new-password"
                       placeholder="Потврдете ја лозинката" />
                <label asp-for="Input.ConfirmPassword" class="form-label">
                    Потврди лозинка
                </label>
                <span asp-validation-for="Input.ConfirmPassword"
                      class="text-danger"></span>
            </div>

            <button type="submit"
                    class="w-100 btn btn-lg btn-primary">
                Зачувај лозинка
            </button>

        </form>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}