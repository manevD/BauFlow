@page
@model RegisterModel
@{
    ViewData["Title"] = "Registrieren";
}

<style>
    /* PRICING CARDS - CLEAN MODERN */

    .plan-wrapper {
        cursor: pointer;
        display: block;
    }

    .modern-card {
        background: #ffffff;
        border-radius: 24px;
        padding: 40px 32px;
        border: 1px solid #e9ecef;
        transition: all .35s ease;
        height: 100%;
        position: relative;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }

        /* Hover */
        .modern-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 25px 60px rgba(0, 0, 0, 0.08);
            border-color: #111;
        }

    /* Selected */
    .plan-wrapper input:checked + .modern-card {
        border: 2px solid #111;
        box-shadow: 0 0 0 4px rgba(0, 0, 0, 0.05);
    }

    /* Featured Card */
    .featured {
        border: 2px solid #111;
        transform: scale(1.05);
    }

        .featured:hover {
            transform: scale(1.05) translateY(-8px);
        }

    /* Plan Header */
    .plan-header {
        text-align: center;
        margin-bottom: 30px;
    }

    .plan-name {
        font-weight: 600;
        font-size: 1.1rem;
        letter-spacing: .5px;
        text-transform: uppercase;
        margin-bottom: 10px;
        display: block;
    }

    .price {
        font-size: 3rem;
        font-weight: 700;
        margin-bottom: 5px;
    }

        .price::after {
            content: " / Месечно";
            font-size: .9rem;
            font-weight: 400;
            color: #777;
        }

    /* Features */
    .modern-card ul {
        list-style: none;
        padding: 0;
        margin: 0 0 25px 0;
    }

        .modern-card ul li {
            padding: 10px 0;
            font-size: .95rem;
            color: #444;
            border-bottom: 1px solid #f1f1f1;
        }

            .modern-card ul li:last-child {
                border-bottom: none;
            }

    /* Popular badge */
    .badge-modern {
        position: absolute;
        top: -14px;
        left: 50%;
        transform: translateX(-50%);
        background: #111;
        color: #fff;
        padding: 6px 14px;
        border-radius: 50px;
        font-size: .7rem;
        letter-spacing: .8px;
        font-weight: 600;
    }
    /* EXTERNAL BUTTON */
    .btn-outline-secondary {
        border: 1px solid #d1d5db !important;
        color: #444 !important;
        border-radius: 14px;
    }

        .btn-outline-secondary:hover {
            background: #f3f4f6 !important;
            color: #000 !important;
        }
    /* Limit */
    .plan-limit {
        text-align: center;
        font-size: .8rem;
        color: #888;
        margin-top: auto;
    }
</style>

<div class="container py-5">

    <div class="text-center mb-4">
        <h1 class="fw-bold display-6">Регистрација</h1>
        <p class="text-muted fs-5">Креирајте ја вашата фирма и изберете план</p>
    </div>

    <!-- STEPPER -->
    <div class="stepper mb-5">
        <div class="step-item active" data-label="Сметка"></div>
        <div class="step-item" data-label="Фирма"></div>
        <div class="step-item" data-label="Даноци"></div>
        <div class="step-item" data-label="План"></div>
    </div>

    <form method="post">

        <div asp-validation-summary="ModelOnly" class="text-danger text-center mb-4"></div>

        <!-- STEP 1 -->
        <div class="step" data-step="1">
            <div class="card p-4 mx-auto" style="max-width:600px">

                <h5 class="mb-4 text-center">Сметка</h5>

                <div class="form-floating mb-3">
                    <input asp-for="Input.Email" class="form-control" />
                    <label asp-for="Input.Email">Е-пошта</label>
                </div>

                <div class="form-floating mb-3">
                    <input asp-for="Input.Password" type="password" class="form-control" />
                    <label asp-for="Input.Password">Лозинка</label>
                </div>

                <div class="form-floating">
                    <input asp-for="Input.ConfirmPassword" type="password" class="form-control" />
                    <label asp-for="Input.ConfirmPassword">Потврди лозинка</label>
                </div>

                <div class="d-flex justify-content-between mt-4">
                    <button type="button" class="btn btn-dark" onclick="nextStep(-1)">Назад</button>
                    <button type="button" class="btn btn-dark" onclick="nextStep(1)">Следно</button>
                </div>

            </div>
        </div>

        <!-- STEP 2 -->
        <div class="step d-none" data-step="2">
            <div class="card p-4 mx-auto" style="max-width:700px">

                <h5 class="mb-4 text-center">Податоци за фирма</h5>

                <div class="form-floating mb-3">
                    <input asp-for="Input.CompanyName" class="form-control" />
                    <label asp-for="Input.CompanyName">Име на фирма</label>
                </div>

                <div class="form-floating mb-3">
                    <input asp-for="Input.Address" class="form-control" />
                    <label asp-for="Input.Address">Адреса</label>
                </div>

                <div class="row">
                    <div class="col-4">
                        <div class="form-floating mb-3">
                            <input asp-for="Input.PostalCode" class="form-control" />
                            <label asp-for="Input.PostalCode">Поштенски број</label>
                        </div>
                    </div>

                    <div class="col-8">
                        <div class="form-floating mb-3">
                            <input asp-for="Input.City" class="form-control" />
                            <label asp-for="Input.City">Град</label>
                        </div>
                    </div>
                </div>

                <div class="form-floating">
                    <input asp-for="Input.Country" value="Северна Македонија" class="form-control" />
                    <label asp-for="Input.Country">Држава</label>
                </div>

                <div class="d-flex justify-content-between mt-4">
                    <button type="button" class="btn btn-dark" onclick="nextStep(-1)">Назад</button>
                    <button type="button" class="btn btn-dark" onclick="nextStep(1)">Следно</button>
                </div>

            </div>
        </div>

        <!-- STEP 3 -->
        <div class="step d-none" data-step="3">
            <div class="card p-4 mx-auto" style="max-width:600px">

                <h5 class="mb-4 text-center">Даночни податоци</h5>

                <div class="form-floating mb-3">
                    <input asp-for="Input.TaxNumber" class="form-control" />
                    <label asp-for="Input.TaxNumber">Даночен број</label>
                </div>
                <div class="form-floating mb-3">
                    <input asp-for="Input.IBAN" class="form-control" />
                    <label asp-for="Input.IBAN">Жиро сметка</label>
                </div>
                <div class="form-floating mb-3">
                    <input asp-for="Input.VatId" class="form-control" />
                    <label asp-for="Input.VatId">ДДВ број</label>
                </div>

                <div class="form-check form-switch">
                    <input asp-for="Input.IsSmallBusiness" class="form-check-input" />
                    <label asp-for="Input.IsSmallBusiness" class="form-check-label">
                        Мало претпријатие
                    </label>
                </div>

                <div class="d-flex justify-content-between mt-4">
                    <button type="button" class="btn btn-dark" onclick="nextStep(-1)">Назад</button>
                    <button type="button" class="btn btn-dark" onclick="nextStep(1)">Следно</button>
                </div>

            </div>
        </div>

        <!-- STEP 4 -->
        <div class="step d-none" data-step="4">

            <h4 class="text-center mb-5">Изберете план</h4>

            <div class="row g-4 justify-content-center">

                <div class="col-md-4">
                    <label class="plan-wrapper">
                        <input type="radio" asp-for="Input.Plan" value="Starter" hidden>
                        <div class="modern-card">
                            <div class="plan-header">
                                <span>Starter</span>
                                <div class="price">1000 МКД</div>
                                <small>за поединци</small>
                            </div>
                        </div>
                    </label>
                </div>

                <div class="col-md-4">
                    <label class="plan-wrapper">
                        <input type="radio" asp-for="Input.Plan" value="Pro" checked hidden>
                        <div class="modern-card featured">
                            <div class="badge-modern">ПОПУЛАРНО</div>
                            <div class="plan-header">
                                <span>Тим</span>
                                <div class="price">1800 МКД</div>
                                <small>за мали тимови</small>
                            </div>
                        </div>
                    </label>
                </div>

                <div class="col-md-4">
                    <label class="plan-wrapper">
                        <input type="radio" asp-for="Input.Plan" value="Business" hidden>
                        <div class="modern-card">
                            <div class="plan-header">
                                <span>Бизнис</span>
                                <div class="price">3400 МКД</div>
                                <small>за растечки компании</small>
                            </div>
                        </div>
                    </label>
                </div>

            </div>

            <div class="d-flex justify-content-between mt-4">
                <button type="button" class="btn btn-dark" onclick="nextStep(-1)">Назад</button>
                <button type="submit" class="btn btn-success">Креирај профил</button>
            </div>

        </div>

    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener("keydown", e=>{
    if(e.key==="Enter" && currentStep<totalSteps){
        e.preventDefault();
        nextStep(1);
    }
});
let currentStep = 1;
const totalSteps = 4;

function showStep(step){

    document.querySelectorAll(".step").forEach(s=>s.classList.add("d-none"));
    document.querySelector(`[data-step="${step}"]`).classList.remove("d-none");

    document.getElementById("prevBtn").style.display = step===1 ? "none":"inline-block";
    document.getElementById("nextBtn").style.display = step===totalSteps ? "none":"inline-block";
    document.getElementById("submitBtn").classList.toggle("d-none", step!==totalSteps);

    document.querySelectorAll(".step-item").forEach((el,index)=>{
        el.classList.remove("active","done");
        if(index+1 < step) el.classList.add("done");
        if(index+1 === step) el.classList.add("active");
    });
}

function nextStep(n){
    currentStep+=n;
    if(currentStep<1) currentStep=1;
    if(currentStep>totalSteps) currentStep=totalSteps;
    showStep(currentStep);
}

showStep(currentStep);
</script>
}

