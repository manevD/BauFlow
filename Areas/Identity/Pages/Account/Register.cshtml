@page
@model RegisterModel
@{
    ViewData["Title"] = "Registrieren";
}

<div class="container py-5">

    <div class="text-center mb-4">
        <h1 class="fw-bold display-6">Registrieren</h1>
        <p class="text-muted fs-5">Erstellen Sie Ihre Firma und wählen Sie Ihren Plan</p>
    </div>

    <!-- STEPPER -->
    <div class="stepper mb-5">
        <div class="step-item active" data-label="Account"></div>
        <div class="step-item" data-label="Firma"></div>
        <div class="step-item" data-label="Steuern"></div>
        <div class="step-item" data-label="Plan"></div>
    </div>

    <form method="post">

        <div asp-validation-summary="ModelOnly" class="text-danger text-center mb-4"></div>

        <!-- STEP 1 -->
        <div class="step" data-step="1">
            <div class="card border-0 shadow-lg p-4 mx-auto" style="max-width:600px">
                <h5 class="mb-4 fw-semibold text-center">Account</h5>

                <div class="form-floating mb-3">
                    <input asp-for="Input.Email" class="form-control" />
                    <label asp-for="Input.Email"></label>
                </div>

                <div class="form-floating mb-3">
                    <input asp-for="Input.Password" class="form-control" />
                    <label asp-for="Input.Password"></label>
                </div>

                <div class="form-floating">
                    <input asp-for="Input.ConfirmPassword" class="form-control" />
                    <label asp-for="Input.ConfirmPassword"></label>
                </div>
            </div>
        </div>

        <!-- STEP 2 -->
        <div class="step d-none" data-step="2">
            <div class="card border-0 shadow-lg p-4 mx-auto" style="max-width:700px">
                <h5 class="mb-4 fw-semibold text-center">Firmendaten</h5>

                <div class="form-floating mb-3">
                    <input asp-for="Input.CompanyName" class="form-control" />
                    <label asp-for="Input.CompanyName"></label>
                </div>

                <div class="form-floating mb-3">
                    <input asp-for="Input.Address" class="form-control" />
                    <label asp-for="Input.Address"></label>
                </div>

                <div class="row">
                    <div class="col-4">
                        <div class="form-floating mb-3">
                            <input asp-for="Input.PostalCode" class="form-control" />
                            <label asp-for="Input.PostalCode"></label>
                        </div>
                    </div>

                    <div class="col-8">
                        <div class="form-floating mb-3">
                            <input asp-for="Input.City" class="form-control" />
                            <label asp-for="Input.City"></label>
                        </div>
                    </div>
                </div>

                <div class="form-floating">
                    <input asp-for="Input.Country" class="form-control" />
                    <label asp-for="Input.Country"></label>
                </div>
            </div>
        </div>

        <!-- STEP 3 -->
        <div class="step d-none" data-step="3">
            <div class="card border-0 shadow-lg p-4 mx-auto" style="max-width:600px">
                <h5 class="mb-4 fw-semibold text-center">Steuerdaten</h5>

                <div class="form-floating mb-3">
                    <input asp-for="Input.TaxNumber" class="form-control" />
                    <label asp-for="Input.TaxNumber"></label>
                </div>

                <div class="form-floating mb-3">
                    <input asp-for="Input.VatId" class="form-control" />
                    <label asp-for="Input.VatId"></label>
                </div>

                <div class="form-check form-switch">
                    <input asp-for="Input.IsSmallBusiness" class="form-check-input" />
                    <label asp-for="Input.IsSmallBusiness" class="form-check-label"></label>
                </div>
            </div>
        </div>

        <!-- STEP 4 -->
        <div class="step d-none" data-step="4">

            <h4 class="text-center mb-5 fw-semibold">Plan auswählen</h4>

            <div class="row g-4 justify-content-center align-items-stretch">

                <!-- STARTER -->
                <div class="col-md-4">
                    <label class="plan-wrapper">
                        <input type="radio" asp-for="Input.Plan" value="Starter" hidden>

                        <div class="modern-card">
                            <div class="plan-header">
                                <span class="plan-name text-success">Starter</span>
                                <div class="price">19€</div>
                                <small>für Einzelunternehmer</small>
                            </div>

                            <ul>
                                <li>1 Benutzer</li>
                                <li>Angebote</li>
                                <li>Rechnungen</li>
                                <li>PDF Export</li>
                                <li>Kundenverwaltung</li>
                            </ul>

                            <div class="plan-limit">max 50 Angebote / Monat</div>
                        </div>
                    </label>
                </div>

                <!-- TEAM -->
                <div class="col-md-4">
                    <label class="plan-wrapper">
                        <input type="radio" asp-for="Input.Plan" value="Team" checked hidden>

                        <div class="modern-card featured">
                            <div class="badge-modern">BELIEBT</div>

                            <div class="plan-header">
                                <span class="plan-name text-primary">Team</span>
                                <div class="price">39€</div>
                                <small>für kleine Teams</small>
                            </div>

                            <ul>
                                <li>5 Benutzer</li>
                                <li>Unbegrenzt Angebote</li>
                                <li>Teamverwaltung</li>
                                <li>Rollen</li>
                                <li>Status Tracking</li>
                            </ul>
                        </div>
                    </label>
                </div>

                <!-- BUSINESS -->
                <div class="col-md-4">
                    <label class="plan-wrapper">
                        <input type="radio" asp-for="Input.Plan" value="Business" hidden>

                        <div class="modern-card">
                            <div class="plan-header">
                                <span class="plan-name text-dark">Business</span>
                                <div class="price">79€</div>
                                <small>für wachsende Firmen</small>
                            </div>

                            <ul>
                                <li>Unbegrenzte Benutzer</li>
                                <li>Alles aus Team</li>
                                <li>API Zugriff</li>
                                <li>Reports</li>
                                <li>Branding</li>
                            </ul>
                        </div>
                    </label>
                </div>

            </div>
        </div>

        <!-- NAV BUTTONS -->
        <div class="d-flex justify-content-between mt-5">

            <button type="button" id="prevBtn" class="btn btn-outline-secondary" onclick="nextStep(-1)">
                Zurück
            </button>

            <button type="button" id="nextBtn" class="btn btn-primary" onclick="nextStep(1)">
                Weiter
            </button>

            <button type="submit" id="submitBtn" class="btn btn-success d-none">
                Konto erstellen
            </button>

        </div>

    </form>
</div>


<style>

/* STEPPER */
.stepper{
    display:flex;
    justify-content:center;
    align-items:center;
    gap:45px;
}
.step-item{
    width:40px;
    height:40px;
    border-radius:50%;
    border:2px solid #dee2e6;
    position:relative;
    transition:.3s;
}
.step-item::after{
    content:attr(data-label);
    position:absolute;
    top:48px;
    left:50%;
    transform:translateX(-50%);
    font-size:.8rem;
    color:#6c757d;
}
.step-item.active{
    background:#0d6efd;
    border-color:#0d6efd;
}
.step-item.active::after{
    color:#0d6efd;
    font-weight:600;
}
.step-item.done{
    background:#198754;
    border-color:#198754;
}
.step-item.done::after{
    color:#198754;
}

/* PRICING */
.plan-wrapper{ display:flex; width:100%; cursor:pointer; }

.modern-card{
    display:flex;
    flex-direction:column;
    width:100%;
    height:100%;
    position:relative;
    background:white;
    border-radius:20px;
    padding:32px 26px;
    border:1px solid #edf0f3;
    transition:.35s cubic-bezier(.21,1.02,.73,1);
    box-shadow:0 6px 18px rgba(0,0,0,.05);
}
.modern-card:hover{
    transform:translateY(-8px);
    box-shadow:0 18px 40px rgba(0,0,0,.12);
}
.plan-wrapper input:checked + .modern-card{
    border:2px solid #0d6efd;
    box-shadow:0 0 0 4px rgba(13,110,253,.15);
}

.featured{
    border:2px solid #0d6efd;
    background:linear-gradient(180deg,#ffffff 0%,#f8fbff 100%);
}

.plan-header{text-align:center;margin-bottom:25px;}
.price{
    font-size:2.3rem;
    font-weight:700;
    background:linear-gradient(90deg,#0d6efd,#4dabf7);
    -webkit-background-clip:text;
    -webkit-text-fill-color:transparent;
}

.modern-card ul{
    list-style:none;
    padding:0;
    margin:0 0 20px 0;
    flex-grow:1;
}
.modern-card ul li{
    padding:7px 0;
    padding-left:24px;
    position:relative;
}
.modern-card ul li:before{
    content:"✓";
    position:absolute;
    left:0;
    color:#0d6efd;
    font-weight:700;
}

.plan-limit{ margin-top:auto; text-align:center; font-size:.85rem; color:#dc3545; }

.badge-modern{
    position:absolute;
    top:-12px;
    left:50%;
    transform:translateX(-50%);
    background:#0d6efd;
    color:white;
    font-size:.7rem;
    padding:5px 12px;
    border-radius:30px;
    font-weight:600;
}
</style>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
let currentStep = 1;
const totalSteps = 4;

function showStep(step){

    document.querySelectorAll(".step").forEach(s=>s.classList.add("d-none"));
    document.querySelector(`[data-step="${step}"]`).classList.remove("d-none");

    document.getElementById("prevBtn").style.display = step===1 ? "none":"inline-block";
    document.getElementById("nextBtn").style.display = step===totalSteps ? "none":"inline-block";
    document.getElementById("submitBtn").classList.toggle("d-none", step!==totalSteps);

    document.querySelectorAll(".step-item").forEach((el,index)=>{
        el.classList.remove("active","done");
        if(index+1 < step) el.classList.add("done");
        if(index+1 === step) el.classList.add("active");
    });
}

function nextStep(n){
    currentStep+=n;
    if(currentStep<1) currentStep=1;
    if(currentStep>totalSteps) currentStep=totalSteps;
    showStep(currentStep);
}

showStep(currentStep);
</script>
}

