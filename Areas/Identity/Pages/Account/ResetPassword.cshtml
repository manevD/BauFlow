@page
@model ResetPasswordModel

@{
    ViewData["Title"] = "Ресетирај лозинка";
}

<div class="container py-5">

    <div class="text-center mb-5">
        <h1 class="fw-bold display-6">Нова лозинка</h1>
        <p class="text-muted fs-5">Поставете нова лозинка за вашата сметка</p>
    </div>

    <div class="row justify-content-center">

        <div class="col-lg-5">

            <div class="card border-0 shadow-lg p-4">

                <form method="post">

                    <div asp-validation-summary="ModelOnly" class="text-danger text-center mb-3"></div>

                    <input asp-for="Input.Code" type="hidden" />

                    <!-- EMAIL -->
                    <div class="form-floating mb-3">
                        <input asp-for="Input.Email"
                               class="form-control"
                               placeholder="email@пример.мк" />
                        <label asp-for="Input.Email">Е-пошта</label>
                        <span asp-validation-for="Input.Email" class="text-danger small"></span>
                    </div>

                    <!-- PASSWORD -->
                    <div class="form-floating mb-3">
                        <input asp-for="Input.Password"
                               type="password"
                               class="form-control"
                               placeholder="Нова лозинка" />
                        <label asp-for="Input.Password">Нова лозинка</label>
                        <span asp-validation-for="Input.Password" class="text-danger small"></span>
                    </div>

                    <!-- CONFIRM -->
                    <div class="form-floating mb-4">
                        <input asp-for="Input.ConfirmPassword"
                               type="password"
                               class="form-control"
                               placeholder="Потврди лозинка" />
                        <label asp-for="Input.ConfirmPassword">Потврди лозинка</label>
                        <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <!-- BUTTON -->
                    <button type="submit" class="btn btn-primary w-100 btn-lg shadow-sm">
                        Зачувај лозинка
                    </button>

                    <!-- BACK -->
                    <div class="text-center mt-4 small">
                        <a asp-page="./Login">
                            Назад кон најава
                        </a>
                    </div>

                </form>

            </div>

        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}