@page
@model ResetPasswordModel

@{
    ViewData["Title"] = "Passwort zurücksetzen";
}

<div class="container py-5">

    <div class="text-center mb-5">
        <h1 class="fw-bold display-6">Neues Passwort</h1>
        <p class="text-muted fs-5">Bitte legen Sie ein neues Passwort fest</p>
    </div>

    <div class="row justify-content-center">

        <div class="col-lg-5">

            <div class="card border-0 shadow-lg p-4">

                <form method="post">

                    <div asp-validation-summary="ModelOnly" class="text-danger text-center mb-3"></div>

                    <input asp-for="Input.Code" type="hidden" />

                    <!-- EMAIL -->
                    <div class="form-floating mb-3">
                        <input asp-for="Input.Email"
                               class="form-control"
                               placeholder="name@example.com" />
                        <label asp-for="Input.Email">E-Mail</label>
                        <span asp-validation-for="Input.Email" class="text-danger small"></span>
                    </div>

                    <!-- PASSWORD -->
                    <div class="form-floating mb-3">
                        <input asp-for="Input.Password"
                               class="form-control"
                               placeholder="Neues Passwort" />
                        <label asp-for="Input.Password">Neues Passwort</label>
                        <span asp-validation-for="Input.Password" class="text-danger small"></span>
                    </div>

                    <!-- CONFIRM -->
                    <div class="form-floating mb-4">
                        <input asp-for="Input.ConfirmPassword"
                               class="form-control"
                               placeholder="Passwort bestätigen" />
                        <label asp-for="Input.ConfirmPassword">Passwort bestätigen</label>
                        <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <!-- BUTTON -->
                    <button type="submit" class="btn btn-primary w-100 btn-lg shadow-sm">
                        Passwort speichern
                    </button>

                    <!-- BACK -->
                    <div class="text-center mt-4 small">
                        <a asp-page="./Login">
                            Zurück zum Login
                        </a>
                    </div>

                </form>

            </div>

        </div>

    </div>
</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}