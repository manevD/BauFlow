@model BauFlow.ViewModels.CompanyViewModel

@{
    ViewData["Title"] = "Фирма - Измени";
}
<link href="~/css/siteUser.css" rel="stylesheet" />

@if (TempData["Success"] != null)
{
    <div style="
        background:#e6fcf5;
        border:1px solid #96f2d7;
        color:#087f5b;
        padding:12px;
        border-radius:12px;
        margin-bottom:20px;">
        
        ✔ @TempData["Success"]
    </div>
}

<div class="container py-4">

    <div class="page-card">

        <h4 class="mb-4">Измени фирма</h4>

        <form asp-action="Edit" method="post">

            <!-- NAME -->
            <div class="section-title">Основни податоци</div>

            <div class="form-floating mb-3">
                <input asp-for="Name" class="form-control" />
                <label>Име на фирма</label>
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <!-- ADDRESS -->
            <div class="form-floating mb-3">
                <input asp-for="Address" class="form-control" />
                <label>Адреса</label>
                <span asp-validation-for="Address" class="text-danger"></span>
            </div>

            <div class="row">
                <div class="col-md-4">
                    <div class="form-floating mb-3">
                        <input asp-for="PostalCode" class="form-control" />
                        <label>Поштенски број</label>
                        <span asp-validation-for="PostalCode" class="text-danger"></span>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="form-floating mb-3">
                        <input asp-for="City" class="form-control" />
                        <label>Град</label>
                        <span asp-validation-for="City" class="text-danger"></span>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="form-floating mb-3">
                        <input asp-for="Country" class="form-control" />
                        <label>Држава</label>
                        <span asp-validation-for="Country" class="text-danger"></span>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="form-floating mb-3">
                        <input type="email" asp-for="Accountant" class="form-control" />
                        <label>Е-пошта на сметководител</label>
                        <span asp-validation-for="Accountant" class="text-danger"></span>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="form-floating mb-3">
                        <input type="email" asp-for="CEO" class="form-control" />
                        <label>Овластено лице</label>
                        <span asp-validation-for="CEO" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <!-- TAX -->
            <div class="section-title mt-3">Даночни податоци</div>

            <div class="form-floating mb-4">
                <input asp-for="TaxNumber" class="form-control" />
                <label>Даночен број</label>
                <span asp-validation-for="TaxNumber" class="text-danger"></span>
            </div>
            <div class="form-floating mb-3">
                <input asp-for="BankName"
                       class="form-control"
                       placeholder="@(string.IsNullOrEmpty(Model?.BankName) ? "Име на банка" : "")" />
                <label>Име на банка</label>
                <span asp-validation-for="BankName" class="text-danger"></span>
            </div>
            <div class="form-floating mb-3">
                <input asp-for="IBAN"
                       class="form-control"
                       placeholder="@(string.IsNullOrEmpty(Model?.IBAN) ? "Број на жиросметка" : "")" />
                <label>Број на жиросметка</label>
                <span asp-validation-for="IBAN" class="text-danger"></span>
            </div>

            <!-- TEST -->
            <button type="submit" class="btn btn-primary-custom w-100">
                    Зачувај
                </button>
            <div id="testResult" class="mb-3"></div>

            <a asp-action="Index" style="margin-top:10px;" type="button" class="btn btn-ghost w-100 mb-3">
                    Откажи
                </a>
        </form>
    </div>
</div>
<script>
    setTimeout(() => {
        const alert = document.querySelector(".alert");
        if (alert) alert.style.display = "none";
    }, 3000);
</script>
