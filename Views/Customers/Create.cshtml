@model BauFlow.Entities.Customer

<style>

    .profile-card {
        background: #fff;
        border: 1px solid #eceef2;
        border-radius: 20px;
        box-shadow: 0 8px 24px rgba(0,0,0,.04);
        padding: 35px;
        width: 100%;
        max-width: 700px;
    }

    .form-control {
        background: #fff;
        border: 1px solid #e2e5ea;
        border-radius: 14px;
    }

        .form-control:focus {
            border-color: #111;
            box-shadow: 0 0 0 3px rgba(0,0,0,.05);
        }

    .btn-primary {
        background: #111 !important;
        border: none !important;
        border-radius: 14px;
        font-weight: 600;
    }

        .btn-primary:hover {
            background: #000 !important;
        }

    .info-box {
        background: #f6f7f9;
        border-radius: 12px;
        padding: 14px;
        font-size: 14px;
        color: #555;
        margin-bottom: 20px;
    }

</style>


<div class="d-flex justify-content-center">

    <div class="profile-card">

        <h4 class="mb-4 text-center">Kunde erstellen</h4>

        <div class="info-box">
            Erfasse hier einen neuen Kunden. Dieser kann später Projekten, Angeboten und Rechnungen zugeordnet werden.
        </div>

        <form asp-action="Create" method="post">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3 text-center"></div>

            <div class="form-floating mb-3">
                <input asp-for="Name" class="form-control" placeholder="Firmenname / Kunde" />
                <label asp-for="Name">Name</label>
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>

            <div class="form-floating mb-3">
                <input asp-for="ContactPerson" class="form-control" placeholder="Ansprechpartner" />
                <label asp-for="ContactPerson">Ansprechpartner</label>
            </div>

            <div class="form-floating mb-3">
                <input asp-for="Email" class="form-control" placeholder="Email" />
                <label asp-for="Email">Email</label>
            </div>

            <div class="form-floating mb-3">
                <input asp-for="Phone" class="form-control" placeholder="Telefon" />
                <label asp-for="Phone">Telefon</label>
            </div>

            <div class="form-floating mb-3">
                <input asp-for="Address" class="form-control" placeholder="Adresse" />
                <label asp-for="Address">Adresse</label>
            </div>

            <div class="form-floating mb-3">
                <input asp-for="PostalCode" class="form-control" placeholder="PLZ" />
                <label asp-for="PostalCode">Postleitzahl</label>
            </div>

            <div class="form-floating mb-3">
                <input asp-for="City" class="form-control" placeholder="Stadt" />
                <label asp-for="City">Stadt</label>
            </div>

            <div class="form-floating mb-3">
                <input asp-for="Country" class="form-control" placeholder="Land" />
                <label asp-for="Country">Land</label>
            </div>

            <div class="form-floating mb-4">
                <textarea asp-for="Notes"
                          class="form-control"
                          style="height:100px"
                          placeholder="Notizen"></textarea>
                <label asp-for="Notes">Notizen</label>
            </div>

            <button type="submit"
                    class="btn btn-primary w-100 btn-lg">
                Kunde speichern
            </button>

        </form>

    </div>

</div>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}