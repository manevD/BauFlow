@model BauFlow.Entities.Customer
<link href="~/css/siteUser.css" rel="stylesheet" />


<div class="d-flex justify-content-center">

        <div class="profile-card">

        <h4 class="mb-4 text-center">Измени клиент</h4>

        <div class="info-box">
            Тука можеш да ги ажурираш податоците за клиентот.
        </div>

        <form asp-action="Edit" method="post">

            <input type="hidden" asp-for="Id" />

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3 text-center"></div>

            <div class="form-floating mb-3">
                <input asp-for="Name" class="form-control" placeholder="Име" />
                <label asp-for="Name">Име</label>
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>

            <div class="form-floating mb-3">
                <input asp-for="ContactPerson" class="form-control" placeholder="Контакт лице" />
                <label asp-for="ContactPerson">Контакт лице</label>
            </div>

            <div class="form-floating mb-3">
                <input asp-for="Email" class="form-control" placeholder="Е-пошта" />
                <label asp-for="Email">Е-пошта</label>
            </div>

            <div class="form-floating mb-3">
                <input asp-for="Phone" class="form-control" placeholder="Телефон" />
                <label asp-for="Phone">Телефон</label>
            </div>

            <div class="form-floating mb-3">
                <input asp-for="Address" class="form-control" placeholder="Адреса" />
                <label asp-for="Address">Адреса</label>
            </div>

            <div class="form-floating mb-3">
                <input asp-for="PostalCode" class="form-control" placeholder="Поштенски број" />
                <label asp-for="PostalCode">Поштенски број</label>
            </div>

            <div class="form-floating mb-3">
                <input asp-for="City" class="form-control" placeholder="Град" />
                <label asp-for="City">Град</label>
            </div>

            <div class="form-floating mb-3">
                <input asp-for="Country" class="form-control" placeholder="Држава" />
                <label asp-for="Country">Држава</label>
            </div>

            <div class="form-floating mb-4">
                <textarea asp-for="Notes"
                          class="form-control"
                          style="height:100px"
                          placeholder="Белешки"></textarea>
                <label asp-for="Notes">Белешки</label>
            </div>

            <div class="d-flex gap-3">

                <button type="submit"
                        class="btn btn-primary flex-fill">
                    Зачувај измени
                </button>

                <a asp-action="Index"
                       class="btn btn-secondary-custom flex-fill">
                    Откажи
                </a>

            </div>

        </form>

    </div>

</div>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}