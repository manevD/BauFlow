@model IEnumerable<BauFlow.Entities.Customer>

@{
    ViewData["Title"] = "Клиенти";
}
<link href="~/css/siteUser.css" rel="stylesheet" />

<div class="page-card w-100" style="max-width:none;">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <h4 class="mb-0">Клиенти</h4>

        <a asp-action="Create" class="btn btn-primary-custom">
            + Додади клиент
        </a>

    </div>

    <div class="mb-4">
        <input type="text"
               id="searchInput"
               class="form-control search-box"
               placeholder="Пребарај клиент..." />
    </div>

    <table class="table align-middle">

        <thead>
            <tr>
                <th></th>
                <th>Име</th>
                <th>Е-пошта</th>
                <th>Локација</th>
                <th>Телефон</th>
                <th class="text-end">Акции</th>
            </tr>
        </thead>

        <tbody id="kundeTable">

            @foreach (var customer in Model)
            {
                <tr>

                    <td>
                        <div class="avatar">
                            @customer.Name.Substring(0, 1).ToUpper()
                        </div>
                    </td>

                    <td>@customer.Name</td>

                    <td>
                        @(string.IsNullOrWhiteSpace(customer.Email) ? "-" : customer.Email)
                    </td>

                    <td>
                        @(string.IsNullOrWhiteSpace(customer.City) ? "-" : customer.City),
                        @(string.IsNullOrWhiteSpace(customer.Country) ? "" : customer.Country)
                    </td>

                    <td>
                        @(string.IsNullOrWhiteSpace(customer.Phone) ? "-" : customer.Phone)
                    </td>

                    <td class="text-end">

                        <a asp-action="Edit"
                               asp-route-id="@customer.Id"
                               class="btn btn-ghost me-2">
                            Измени
                        </a>

                        <a asp-action="Details"
                               asp-route-id="@customer.Id"
                               class="btn btn-ghost">
                            Детали
                        </a>

                        <a asp-action="Delete"
                               asp-route-id="@customer.Id"
                               class="btn btn-ghost-danger">
                            Избриши
                        </a>
                    </td>

                </tr>
            }

        </tbody>

    </table>

</div>


@section Scripts {

    <script>

        const searchInput = document.getElementById("searchInput");
        const rows = document.querySelectorAll("#kundeTable tr");

        searchInput.addEventListener("keyup", function () {

            const value = this.value.toLowerCase();

            rows.forEach(row => {

                const text = row.innerText.toLowerCase();

                row.style.display = text.includes(value) ? "" : "none";

            });

        });

    </script>

}