@model IEnumerable<BauFlow.Entities.Customer>

@{
    ViewData["Title"] = "Клиенти";
}

<style>

    .page-card {
        background: #fff;
        border: 1px solid #eceef2;
        border-radius: 20px;
        box-shadow: 0 8px 24px rgba(0,0,0,.04);
        padding: 32px;
    }

    .btn-primary-custom {
        background: #111;
        border: none;
        color: #fff;
        border-radius: 12px;
        font-weight: 600;
        padding: 8px 16px;
        font-size: 14px;
    }

        .btn-primary-custom:hover {
            background: #000;
        }

    .btn-ghost {
        background: #f6f7f9;
        border: none;
        border-radius: 10px;
        padding: 6px 12px;
        font-size: 13px;
    }

        .btn-ghost:hover {
            background: #eceef2;
        }

    .btn-danger-ghost {
        background: #fafafa;
        border: none;
        border-radius: 10px;
        padding: 6px 12px;
        font-size: 13px;
    }

        .btn-danger-ghost:hover {
            background: #f1f1f1;
        }

    thead {
        background: #fafafa;
    }

    th {
        font-weight: 600;
        font-size: 14px;
    }

    tbody tr:hover {
        background: #f9f9fb;
    }

    td {
        vertical-align: middle;
        font-size: 14px;
    }

    .avatar {
        width: 34px;
        height: 34px;
        border-radius: 50%;
        background: #111;
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 13px;
        font-weight: 600;
    }

    .search-box {
        max-width: 320px;
    }

</style>


<div class="page-card">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <h4 class="mb-0">Клиенти</h4>

        <a asp-action="Create" class="btn btn-primary-custom">
            + Додади клиент
        </a>

    </div>

    <div class="mb-4">
        <input type="text"
               id="searchInput"
               class="form-control search-box"
               placeholder="Пребарај клиент..." />
    </div>

    <table class="table align-middle">

        <thead>
            <tr>
                <th></th>
                <th>Име</th>
                <th>Е-пошта</th>
                <th>Локација</th>
                <th>Телефон</th>
                <th class="text-end">Акции</th>
            </tr>
        </thead>

        <tbody id="kundeTable">

            @foreach (var customer in Model)
            {
                <tr>

                    <td>
                        <div class="avatar">
                            @customer.Name.Substring(0, 1).ToUpper()
                        </div>
                    </td>

                    <td>@customer.Name</td>

                    <td>
                        @(string.IsNullOrWhiteSpace(customer.Email) ? "-" : customer.Email)
                    </td>

                    <td>
                        @(string.IsNullOrWhiteSpace(customer.City) ? "-" : customer.City),
                        @(string.IsNullOrWhiteSpace(customer.Country) ? "" : customer.Country)
                    </td>

                    <td>
                        @(string.IsNullOrWhiteSpace(customer.Phone) ? "-" : customer.Phone)
                    </td>

                    <td class="text-end">

                        <a asp-action="Edit"
                               asp-route-id="@customer.Id"
                               class="btn btn-ghost me-2">
                            Измени
                        </a>

                        <a asp-action="Details"
                               asp-route-id="@customer.Id"
                               class="btn btn-ghost">
                            Детали
                        </a>

                        <a asp-action="Delete"
                               asp-route-id="@customer.Id"
                               class="btn btn-ghost">
                            Избриши
                        </a>
                    </td>

                </tr>
            }

        </tbody>

    </table>

</div>


@section Scripts {

    <script>

        const searchInput = document.getElementById("searchInput");
        const rows = document.querySelectorAll("#kundeTable tr");

        searchInput.addEventListener("keyup", function () {

            const value = this.value.toLowerCase();

            rows.forEach(row => {

                const text = row.innerText.toLowerCase();

                row.style.display = text.includes(value) ? "" : "none";

            });

        });

    </script>

}