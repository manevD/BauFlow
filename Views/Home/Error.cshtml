@model ErrorViewModel
@{
    ViewData["Title"] = "Грешка";
}
<style>
    .error-container {
        height: 80vh;
        display: flex;
        justify-content: center;
        align-items: center;
        background: #f6f8fb;
    }

    .error-card {
        background: white;
        padding: 50px;
        border-radius: 20px;
        text-align: center;
        max-width: 500px;
        width: 100%;
    }

    .error-icon {
        font-size: 50px;
        margin-bottom: 15px;
    }

    .error-title {
        font-weight: 700;
        margin-bottom: 10px;
    }

    .error-text {
        color: #6c757d;
        margin-bottom: 25px;
    }

    .error-actions {
        display: flex;
        gap: 10px;
        justify-content: center;
    }

    .error-id {
        margin-top: 20px;
        font-size: 13px;
        color: #999;
    }
</style>

<div class="error-container">

    <div class="error-card shadow-lg">

        <div class="error-icon">⚠</div>

        <h1 class="error-title">Упс, нешто тргна наопаку</h1>

        <p class="error-text">
            Се појави неочекувана грешка.<br />
            Обиди се повторно или контактирај поддршка.
        </p>

        <div class="error-actions">

            <a href="/" class="btn btn-primary">
                Почетна страница
            </a>

            <button onclick="location.reload()" class="btn btn-outline-secondary">
                Освежи страница
            </button>

        </div>

        @if (Model?.RequestId != null)
        {
            <div class="error-id">
                ID на грешка: <strong>@Model.RequestId</strong>
            </div>
        }

    </div>

</div>