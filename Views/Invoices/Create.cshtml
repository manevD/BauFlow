@model BauFlow.Entities.Invoice


<link href="~/css/siteUser.css" rel="stylesheet" />


<div class="page-card w-100" style="max-width:none;">

    <h4 class="mb-4">Нова фактура</h4>

    <form asp-action="Create" method="post">

        <div class="row mb-4">

            <!-- Клиент -->
            <div class="col-md-6">
                <div class="form-floating">
                    <select asp-for="CustomerId"
                            asp-items="ViewBag.CustomerId"
                            class="form-control"></select>
                    <label>Клиент</label>
                </div>
            </div>

            <!-- Due Date -->
            <div class="col-md-6">
                <div class="form-floating">
                    <input asp-for="DueDate" type="date" class="form-control" />
                    <label>Рок на плаќање</label>
                </div>
            </div>

        </div>
        <!-- Опис -->
        <div class="form-floating mb-4">
            <textarea asp-for="Description"
                      class="form-control"
                      style="height: 120px"></textarea>
            <label>Текст на фактура</label>
        </div>

        <hr />

        <h5>Ставки</h5>

        <table class="table" id="itemsTable">
            <thead>
                <tr>
                    <th>Опис</th>
                    <th>Количина</th>
                    <th>Единица</th>
                    <th>Цена</th>
                    <th>Вкупно</th>
                    <th></th>
                </tr>
            </thead>

            <tbody>
                <tr>
                    <td>
                        <input name="Items[0].Description" class="form-control" />
                    </td>

                    <td>
                        <input type="number" step="0.01" value="1"
                               name="Items[0].Quantity"
                               class="form-control qty" />
                    </td>

                    <td>
                        <input name="Items[0].Unit" value="бр."
                               class="form-control" />
                    </td>

                    <td>
                        <input type="number" step="0.01" value="0"
                               name="Items[0].UnitPrice"
                               class="form-control price" />
                    </td>

                    <td>
                        <input type="number" step="0.01"
                               name="Items[0].TotalPrice"
                               class="form-control total"
                               readonly />
                    </td>

                    <td>
                        <button type="button" class="btn btn-ghost removeRow">x</button>
                    </td>
                </tr>
            </tbody>
        </table>

        <button type="button" id="addRow" class="btn btn-ghost mb-3">
            + Додади ставка
        </button>
        <div class="row justify-content-end">

            <div class="col-md-4">
                <!-- SUMMARY -->
                <div class="summary-box">

                    <select asp-for="TaxRate"
                            asp-items="ViewBag.TaxRates"
                            class="form-select mb-3"
                            id="taxRate"></select>

                    <div class="summary-row">
                        <span>Нето</span>
                        <strong id="netTotal">0 МКД</strong>
                    </div>

                    <div class="summary-row">
                        <span id="taxLabel">ДДВ (19%)</span>
                        <strong id="taxTotal">0 МКД</strong>
                    </div>

                    <div class="summary-total d-flex justify-content-between">
                        <span>Вкупно</span>
                        <span id="grossTotal">0 МКД</span>
                    </div>

                </div>
            </div>

        </div>
        <button class="btn btn-primary-custom w-100 mt-4">
            Зачувај фактура
        </button>

    </form>

</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            console.log("INVOICE JS LOADED");

            const taxRateEl = document.getElementById("taxRate");
            const tbody = document.querySelector("#itemsTable tbody");

            let rowIndex = tbody.querySelectorAll("tr").length;

            // ===== PARSER =====
            function parseNumber(val) {
                if (!val) return 0;
                return parseFloat(
                    val.toString()
                        .replace(/\./g, "")
                        .replace(",", ".")
                ) || 0;
            }

            function formatCurrency(val) {
                return new Intl.NumberFormat('mk-MK', {
                    style: 'currency',
                    currency: 'MKD'
                }).format(val || 0);
            }

            // ===== CALCULATE =====
            function calculate() {

                let net = 0;

                tbody.querySelectorAll("tr").forEach(row => {

                    const qty = parseNumber(row.querySelector(".qty")?.value);
                    const price = parseNumber(row.querySelector(".price")?.value);

                    const total = qty * price;

                    const totalInput = row.querySelector(".total");
                    if (totalInput) totalInput.value = total.toFixed(2);

                    net += total;
                });

                const taxRate = parseNumber(taxRateEl?.value);
                const tax = net * taxRate / 100;
                const gross = net + tax;

                document.getElementById("netTotal").innerText = formatCurrency(net);
                document.getElementById("taxTotal").innerText = formatCurrency(tax);
                document.getElementById("grossTotal").innerText = formatCurrency(gross);
                document.getElementById("taxLabel").innerText = `ДДВ (${taxRate}%)`;
            }

            // ===== ADD ROW (FIXED) =====
            document.getElementById("addRow").addEventListener("click", function () {

                const row = `
                <tr>
                    <td><input name="Items[${rowIndex}].Description" class="form-control"/></td>

                    <td><input type="number" step="0.01" value="1"
                               name="Items[${rowIndex}].Quantity"
                               class="form-control qty"/></td>

                    <td><input name="Items[${rowIndex}].Unit" value="бр."
                               class="form-control"/></td>

                    <td><input type="number" step="0.01" value="0"
                               name="Items[${rowIndex}].UnitPrice"
                               class="form-control price"/></td>

                    <td><input type="number" step="0.01" 
                               name="Items[${rowIndex}].TotalPrice"
                               class="form-control total"
                               readonly/></td>

                    <td><button type="button" class="btn btn-ghost removeRow">x</button></td>
                </tr>`;

                tbody.insertAdjacentHTML("beforeend", row);

                rowIndex++;
                calculate();
            });

            // ===== REMOVE ROW =====
            document.addEventListener("click", function (e) {
                if (e.target.classList.contains("removeRow")) {
                    e.target.closest("tr").remove();
                    calculate();
                }
            });

            // ===== LIVE INPUT =====
            document.addEventListener("input", function (e) {
                if (e.target.classList.contains("qty") ||
                    e.target.classList.contains("price")) {
                    calculate();
                }
            });

            taxRateEl?.addEventListener("change", calculate);

            // ===== INIT =====
            setTimeout(calculate, 50);

        });
    </script>
}