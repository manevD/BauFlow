@model BauFlow.Entities.Invoice
<link href="~/css/siteUser.css" rel="stylesheet" />


<div class="container-fluid py-4">

    <div class="page-card w-100" style="max-width:none;">

        <h4 class="mb-4">Избриши фактура</h4>

        <div class="warning-box">
            Оваа фактура ќе биде трајно избришана. Поврзаните податоци може да се изгубат.
        </div>

        <div class="info-row row">
            <div class="col-4 label">Број на фактура</div>
            <div class="col-8 value">@Model.InvoiceNumber</div>
        </div>

        <div class="info-row row">
            <div class="col-4 label">Датум</div>
            <div class="col-8 value">@Model.InvoiceDate.ToShortDateString()</div>
        </div>

        <div class="info-row row">
            <div class="col-4 label">Рок на плаќање</div>
            <div class="col-8 value">@Model.DueDate.ToShortDateString()</div>
        </div>

        <div class="info-row row">
            <div class="col-4 label">Статус</div>
            <div class="col-8 value">@Model.Status.GetDisplayName()</div>
        </div>

        <div class="info-row row">
            <div class="col-4 label">Нето</div>
            <div class="col-8 value">@Model.NetAmount €</div>
        </div>

        <div class="info-row row">
            <div class="col-4 label">Данок</div>
            <div class="col-8 value">@Model.TaxAmount €</div>
        </div>

        <div class="info-row row">
            <div class="col-4 label">Вкупно</div>
            <div class="col-8 value">@Model.GrossAmount МКД</div>
        </div>

        <div class="info-row row">
            <div class="col-4 label">Клиент</div>
            <div class="col-8 value">
                @Model.Customer?.Name
            </div>
        </div>

        <div class="info-row row">
            <div class="col-4 label">Креирано на</div>
            <div class="col-8 value">@Model.CreatedAt.ToShortDateString()</div>
        </div>

        <form asp-action="Delete" method="post" class="mt-4">

            <input type="hidden" asp-for="Id" />

            <div class="d-flex gap-3">

                <button type="submit" class="btn btn-danger-custom">
                    Избриши фактура
                </button>

                <a asp-action="Index" class="btn btn-light-custom">
                    Откажи
                </a>

            </div>
        </form>

    </div>

</div>