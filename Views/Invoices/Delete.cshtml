@model BauFlow.Entities.Invoice

<style>

    .page-card {
        background: #fff;
        border: 1px solid #eceef2;
        border-radius: 20px;
        box-shadow: 0 8px 24px rgba(0,0,0,.04);
        padding: 30px;
        max-width: 750px;
        margin: auto;
    }

    .warning-box {
        background: #fff5f5;
        border: 1px solid #ffe3e3;
        color: #c92a2a;
        border-radius: 12px;
        padding: 14px;
        margin-bottom: 20px;
        font-size: 14px;
    }

    .info-row {
        border-bottom: 1px solid #f1f1f1;
        padding: 12px 0;
    }

    .label {
        font-weight: 500;
        color: #666;
    }

    .value {
        color: #111;
    }

    .btn-danger-custom {
        background: #111;
        color: #fff;
        border: none;
        border-radius: 12px;
        padding: 8px 16px;
    }

        .btn-danger-custom:hover {
            background: #000;
        }

    .btn-light-custom {
        background: #f6f7f9;
        border: none;
        border-radius: 12px;
        padding: 8px 16px;
    }

        .btn-light-custom:hover {
            background: #eceef2;
        }

</style>

<div class="container-fluid py-4">

    <div class="page-card">

        <h4 class="mb-4">Rechnung löschen</h4>

        <div class="warning-box">
            Diese Rechnung wird dauerhaft gelöscht. Zugehörige Daten können verloren gehen.
        </div>

        <div class="info-row row">
            <div class="col-4 label">Rechnungsnummer</div>
            <div class="col-8 value">@Model.InvoiceNumber</div>
        </div>

        <div class="info-row row">
            <div class="col-4 label">Datum</div>
            <div class="col-8 value">@Model.InvoiceDate.ToShortDateString()</div>
        </div>

        <div class="info-row row">
            <div class="col-4 label">Fällig am</div>
            <div class="col-8 value">@Model.DueDate.ToShortDateString()</div>
        </div>

        <div class="info-row row">
            <div class="col-4 label">Status</div>
            <div class="col-8 value">@Model.Status.GetDisplayName()</div>
        </div>

        <div class="info-row row">
            <div class="col-4 label">Netto</div>
            <div class="col-8 value">@Model.NetAmount €</div>
        </div>

        <div class="info-row row">
            <div class="col-4 label">Steuer</div>
            <div class="col-8 value">@Model.TaxAmount €</div>
        </div>

        <div class="info-row row">
            <div class="col-4 label">Brutto</div>
            <div class="col-8 value">@Model.GrossAmount €</div>
        </div>

        <div class="info-row row">
            <div class="col-4 label">Kunde</div>
            <div class="col-8 value">
                @Model.Customer?.Name
            </div>
        </div>

        <div class="info-row row">
            <div class="col-4 label">Erstellt am</div>
            <div class="col-8 value">@Model.CreatedAt.ToShortDateString()</div>
        </div>

        <form asp-action="Delete" method="post" class="mt-4">

            <input type="hidden" asp-for="Id" />

            <div class="d-flex gap-3">

                <button type="submit" class="btn btn-danger-custom">
                    Rechnung löschen
                </button>

                <a asp-action="Index" class="btn btn-light-custom">
                    Abbrechen
                </a>
            </div>
        </form>

    </div>

</div>