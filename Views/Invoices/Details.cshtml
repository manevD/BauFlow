@using BauFlow.Entities
@model BauFlow.Entities.Invoice

<style>

    .page-card {
        background: #fff;
        border: 1px solid #eceef2;
        border-radius: 20px;
        box-shadow: 0 8px 24px rgba(0,0,0,.04);
        padding: 32px;
    }

    .status-pill {
        border-radius: 20px;
        padding: 5px 10px;
        font-size: 12px;
        font-weight: 500;
    }

    .status-draft {
        background: #f6f7f9;
        color: #555;
    }

    .status-paid {
        background: #111;
        color: #fff;
    }

    .btn-primary-custom {
        background: #111;
        border: none;
        color: #fff;
        border-radius: 12px;
        padding: 8px 16px;
        font-weight: 600;
    }

        .btn-primary-custom:hover {
            background: #000;
        }

    .btn-ghost {
        background: #f6f7f9;
        border: none;
        border-radius: 10px;
        padding: 6px 12px;
    }

        .btn-ghost:hover {
            background: #eceef2;
        }

    thead {
        background: #fafafa;
    }

    .total-box {
        background: #fafafa;
        padding: 20px;
        border-radius: 14px;
    }

    .info-row {
        border-bottom: 1px solid #f1f1f1;
        padding: 12px 0;
    }

    .label {
        color: #666;
    }

    .value {
        font-weight: 500;
    }

</style>


<div class="page-card">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h4 class="mb-1">
                Rechnung @Model.InvoiceNumber
            </h4>

            <span class="text-muted">
                @Model.InvoiceDate.ToString("dd.MM.yyyy")
            </span>

        </div>

        <div class="d-flex gap-2">
            @if (!string.IsNullOrEmpty(Model.Customer.Email))
            {
                <a asp-action="SendInvoice"
                       asp-route-invoiceId="@Model.Id"
                       asp-route-customerId="@Model.CustomerId"
                       class="btn btn-ghost">
                    Send
                </a>
            }
         
            <a asp-action="Pdf"
                   asp-route-id="@Model.Id"
                   class="btn btn-ghost">
                PDF
            </a>

            <a asp-action="Edit"
                   asp-route-id="@Model.Id"
                   class="btn btn-ghost">
                Bearbeiten
            </a>
            <a asp-action="Delete"
                   asp-route-id="@Model.Id"
                   class="btn btn-ghost">
                Löschen
            </a>

            <a asp-action="Pdf"
                   asp-route-id="@Model.Id"
                   class="btn btn-ghost">
                PDF herunterladen
            </a>
        </div>

    </div>


    <div class="row mb-4">

        <div class="col-md-6">

            <div class="info-row row">

                <div class="col-4 label">Kunde</div>

                <div class="col-8 value">
                    @Model.Customer?.Name
                </div>

            </div>

            <div class="info-row row">

                <div class="col-4 label">Rechnungsdatum</div>

                <div class="col-8 value">
                    @Model.InvoiceDate.ToString("dd.MM.yyyy")
                </div>

            </div>

            <div class="info-row row">

                <div class="col-4 label">Fällig</div>

                <div class="col-8 value">
                    @Model.DueDate.ToString("dd.MM.yyyy")
                </div>

            </div>

        </div>


        <div class="col-md-6 text-end">

            @if (Model.Status == InvoiceStatus.Paid)
            {
                <span class="status-pill status-paid">
                    Bezahlt
                </span>
            }
            else
            {
                <span class="status-pill status-draft">
                    @Model.Status.GetDisplayName()
                </span>
            }

        </div>

    </div>

    <hr class="mb-4" />

    <h5 class="mb-3">Positionen</h5>

    <table class="table align-middle">

        <thead>

            <tr>

                <th>Beschreibung</th>
                <th width="120">Menge</th>
                <th width="140">Preis</th>
                <th width="140">Total</th>

            </tr>

        </thead>

        <tbody>

            @foreach (var item in Model.Items)
            {

                <tr>

                    <td>
                        @item.Description
                    </td>

                    <td>
                        @item.Quantity @item.Unit
                    </td>

                    <td>
                        @item.UnitPrice.ToString("0.00") €
                    </td>

                    <td>
                        @item.TotalPrice.ToString("0.00") €
                    </td>

                </tr>

            }

        </tbody>

    </table>


    <div class="row justify-content-end mt-4">

        <div class="col-md-4">

            <div class="total-box">

                <div class="d-flex justify-content-between mb-2">

                    <span>Netto</span>

                    <strong>
                        @Model.NetAmount.ToString("0.00") €
                    </strong>

                </div>

                <div class="d-flex justify-content-between mb-2">

                    <span>MwSt (@Model.TaxRate%)</span>

                    <strong>
                        @Model.TaxAmount.ToString("0.00") €
                    </strong>

                </div>

                <hr>

                <div class="d-flex justify-content-between">

                    <h5>Gesamt</h5>

                    <h5>
                        @Model.GrossAmount.ToString("0.00") €
                    </h5>

                </div>

            </div>

        </div>

    </div>

</div>