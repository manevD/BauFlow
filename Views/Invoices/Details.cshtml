@using BauFlow.Entities
@model BauFlow.Entities.Invoice

<style>

    .page-card {
        background: #fff;
        border: 1px solid #eceef2;
        border-radius: 20px;
        box-shadow: 0 8px 24px rgba(0,0,0,.04);
        padding: 32px;
    }

    .status-pill {
        border-radius: 20px;
        padding: 5px 10px;
        font-size: 12px;
        font-weight: 500;
    }

    .status-draft {
        background: #f6f7f9;
        color: #555;
    }

    .status-paid {
        background: #111;
        color: #fff;
    }

    .btn-primary-custom {
        background: #111;
        border: none;
        color: #fff;
        border-radius: 12px;
        padding: 8px 16px;
        font-weight: 600;
    }

        .btn-primary-custom:hover {
            background: #000;
        }

    .btn-ghost {
        background: #f6f7f9;
        border: none;
        border-radius: 10px;
        padding: 6px 12px;
    }

        .btn-ghost:hover {
            background: #eceef2;
        }

    thead {
        background: #fafafa;
    }

    .total-box {
        background: #fafafa;
        padding: 20px;
        border-radius: 14px;
    }

    .info-row {
        border-bottom: 1px solid #f1f1f1;
        padding: 12px 0;
    }

    .label {
        color: #666;
    }

    .value {
        font-weight: 500;
    }

</style>


<div class="page-card">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h4 class="mb-1">
                Фактура @Model.InvoiceNumber
            </h4>

            <span class="text-muted">
                @Model.InvoiceDate.ToString("dd.MM.yyyy")
            </span>

        </div>

        <div class="d-flex gap-2">
            @if (!string.IsNullOrEmpty(Model.Customer.Email))
            {
                <a asp-action="SendInvoice"
                       asp-route-invoiceId="@Model.Id"
                       asp-route-customerId="@Model.CustomerId"
                       class="btn btn-ghost">
                    Испрати
                </a>
            }

            <a asp-action="Pdf"
                   asp-route-id="@Model.Id"
                   class="btn btn-ghost">
                PDF
            </a>

            <a asp-action="Edit"
                   asp-route-id="@Model.Id"
                   class="btn btn-ghost">
                Измени
            </a>

            <a asp-action="Delete"
                   asp-route-id="@Model.Id"
                   class="btn btn-ghost">
                Избриши
            </a>

            <a asp-action="Pdf"
                   asp-route-id="@Model.Id"
                   class="btn btn-ghost">
                Преземи PDF
            </a>
        </div>

    </div>


    <div class="row mb-4">

        <div class="col-md-6">

            <div class="info-row row">
                <div class="col-4 label">Клиент</div>
                <div class="col-8 value">
                    @Model.Customer?.Name
                </div>
            </div>

            <div class="info-row row">
                <div class="col-4 label">Датум на фактура</div>
                <div class="col-8 value">
                    @Model.InvoiceDate.ToString("dd.MM.yyyy")
                </div>
            </div>

            <div class="info-row row">
                <div class="col-4 label">Рок на плаќање</div>
                <div class="col-8 value">
                    @Model.DueDate.ToString("dd.MM.yyyy")
                </div>
            </div>

        </div>


        <div class="col-md-6 text-end">

            @if (Model.Status == InvoiceStatus.Paid)
            {
                <span class="status-pill status-paid">
                    Платено
                </span>
            }
            else
            {
                <span class="status-pill status-draft">
                    @Model.Status.GetDisplayName()
                </span>
            }

        </div>

    </div>

    <hr class="mb-4" />

    <h5 class="mb-3">Ставки</h5>

    <table class="table align-middle">

        <thead>
            <tr>
                <th>Опис</th>
                <th width="120">Количина</th>
                <th width="140">Цена</th>
                <th width="140">Вкупно</th>
            </tr>
        </thead>

        <tbody>

            @foreach (var item in Model.Items)
            {

                <tr>

                    <td>@item.Description</td>

                    <td>@item.Quantity @item.Unit</td>

                    <td>@item.UnitPrice.ToString("0.00") €</td>

                    <td>@item.TotalPrice.ToString("0.00") €</td>

                </tr>

            }

        </tbody>

    </table>


    <div class="row justify-content-end mt-4">

        <div class="col-md-4">

            <div class="total-box">

                <div class="d-flex justify-content-between mb-2">
                    <span>Нето</span>
                    <strong>@Model.NetAmount.ToString("0.00") €</strong>
                </div>

                <div class="d-flex justify-content-between mb-2">
                    <span>ДДВ (@Model.TaxRate%)</span>
                    <strong>@Model.TaxAmount.ToString("0.00") €</strong>
                </div>

                <hr>

                <div class="d-flex justify-content-between">
                    <h5>Вкупно</h5>
                    <h5>@Model.GrossAmount.ToString("0.00") €</h5>
                </div>

            </div>

        </div>

    </div>

</div>