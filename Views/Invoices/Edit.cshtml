@model BauFlow.Entities.Invoice

@{
    ViewData["Title"] = "Rechnung bearbeiten";
}

<style>
    .page-card {
        background: #fff;
        border: 1px solid #eceef2;
        border-radius: 20px;
        box-shadow: 0 8px 24px rgba(0,0,0,.04);
        padding: 32px;
    }

    .section-title {
        font-size: 13px;
        font-weight: 700;
        color: #666;
        text-transform: uppercase;
        margin-bottom: 12px;
    }

    .form-control, .form-select {
        border-radius: 14px;
        border: 1px solid #e2e5ea;
        min-height: 52px;
    }

    .table-editor th {
        background: #fafafa;
        font-size: 13px;
        color: #666;
    }

    .summary-box {
        background: #f6f7f9;
        border-radius: 16px;
        padding: 20px;
    }

    .summary-row {
        display: flex;
        justify-content: space-between;
        margin-bottom: 10px;
    }

    .summary-total {
        font-weight: 700;
        font-size: 18px;
        border-top: 1px solid #ddd;
        padding-top: 10px;
    }

    .btn-primary-custom {
        background: #111;
        color: #fff;
        border: none;
        border-radius: 12px;
        padding: 10px 18px;
        font-weight: 600;
    }

    .btn-ghost {
        background: #f6f7f9;
        border: none;
        border-radius: 10px;
        padding: 6px 12px;
    }
</style>

<div class="page-card">

    <h4 class="mb-4">Rechnung bearbeiten</h4>

    <form asp-action="Edit" method="post">

        <input type="hidden" asp-for="Id" />

        <!-- ================== Allgemein ================== -->
        <div class="section-title">Allgemein</div>

        <div class="row g-3 mb-4">

            <div class="col-md-6">
                <div class="form-floating">
                    <select asp-for="CustomerId"
                            asp-items="ViewBag.CustomerId"
                            class="form-select"></select>
                    <label>Kunde</label>
                </div>
            </div>

            <div class="col-md-6">
                <div class="form-floating">
                    <input asp-for="InvoiceNumber" class="form-control" />
                    <label>Rechnungsnummer</label>
                </div>
            </div>

            <div class="col-md-4">
                <div class="form-floating">
                    <input asp-for="InvoiceDate" type="date" class="form-control" />
                    <label>Rechnungsdatum</label>
                </div>
            </div>

            <div class="col-md-4">
                <div class="form-floating">
                    <input asp-for="DueDate" type="date" class="form-control" />
                    <label>Fälligkeitsdatum</label>
                </div>
            </div>

            <div class="col-md-4">
                <div class="form-floating">
                    <select asp-for="Status"
                            asp-items="Html.GetEnumSelectList<BauFlow.Entities.InvoiceStatus>()"
                            class="form-select"></select>
                    <label>Status</label>
                </div>
            </div>

        </div>

        <!-- ================== Positionen ================== -->
        <div class="section-title">Positionen</div>

        <table class="table table-editor align-middle" id="itemsTable">
            <thead>
                <tr>
                    <th>Beschreibung</th>
                    <th>Menge</th>
                    <th>Einheit</th>
                    <th>Preis</th>
                    <th>Total</th>
                    <th></th>
                </tr>
            </thead>

            <tbody>
                @for (int i = 0; i < Model.Items.Count; i++)
                {
                    <tr>
                        <td>
                            <input name="Items[@i].Description"
                                   value="@Model.Items.ElementAt(i).Description"
                                   class="form-control" />
                        </td>

                        <td>
                            <input type="number" step="0.01"
                                   name="Items[@i].Quantity"
                                   value="@Model.Items.ElementAt(i).Quantity.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)"
                                   class="form-control qty" />
                        </td>

                        <td>
                            <input name="Items[@i].Unit"
                                   value="@Model.Items.ElementAt(i).Unit"
                                   class="form-control" />
                        </td>

                        <td>
                            <input type="number" step="0.01"
                                   name="Items[@i].UnitPrice"
                                   value="@Model.Items.ElementAt(i).UnitPrice.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)"
                                   class="form-control price" />
                        </td>

                        <td>
                            <input type="number" step="0.01"
                                   name="Items[@i].TotalPrice"
                                   value="@Model.Items.ElementAt(i).TotalPrice.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)"
                                   class="form-control total" readonly />
                        </td>

                        <td>
                            <button type="button" class="btn btn-ghost removeRow">x</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <button type="button" id="addRow" class="btn btn-ghost mb-4">
            + Position hinzufügen
        </button>

        <!-- ================== SUMMARY ================== -->
        <div class="row justify-content-end">

            <div class="col-md-4">

                <div class="summary-box">

                    <!-- Steuersatz -->
                    <div class="form-floating mb-3">
                        <select asp-for="TaxRate"
                                asp-items="ViewBag.TaxRates"
                                class="form-select"
                                id="taxRate">
                        </select>
                        <label>Steuersatz</label>
                    </div>

                    <div class="summary-row">
                        <span>Netto</span>
                        <strong id="netTotal">@Model.NetAmount.ToString("0.00") €</strong>
                    </div>

                    <div class="summary-row">
                        <span id="taxLabel">MwSt (@Model.TaxRate%)</span>
                        <strong id="taxTotal">@Model.TaxAmount.ToString("0.00") €</strong>
                    </div>

                    <div class="summary-total d-flex justify-content-between">
                        <span>Gesamt</span>
                        <span id="grossTotal">@Model.GrossAmount.ToString("0.00") €</span>
                    </div>

                </div>

            </div>

        </div>

        <button class="btn btn-primary-custom w-100 mt-4">
            Speichern
        </button>

    </form>

</div>

@section Scripts {

    <script>

        document.addEventListener("DOMContentLoaded", function () {

            let index = document.querySelectorAll("#itemsTable tbody tr").length;

            document.getElementById("addRow").addEventListener("click", function () {

                let row = `
                <tr>
                <td><input name="Items[${index}].Description" class="form-control"/></td>
                <td><input type="number" step="0.01" name="Items[${index}].Quantity" class="form-control qty"/></td>
                <td><input name="Items[${index}].Unit" class="form-control"/></td>
                <td><input type="number" step="0.01" name="Items[${index}].UnitPrice" class="form-control price"/></td>
                <td><input type="number" step="0.01" name="Items[${index}].TotalPrice" class="form-control total" readonly/></td>
                <td><button type="button" class="btn btn-ghost removeRow">x</button></td>
                </tr>
                `;

                document.querySelector("#itemsTable tbody").insertAdjacentHTML("beforeend", row);
                index++;
            });

            document.addEventListener("click", function (e) {
                if (e.target.classList.contains("removeRow")) {
                    e.target.closest("tr").remove();
                    calculate();
                }
            });

            document.addEventListener("input", function (e) {
                if (e.target.classList.contains("qty") || e.target.classList.contains("price")) {
                    calculate();
                }
            });

            document.getElementById("taxRate").addEventListener("change", calculate);

            function calculate() {

                let net = 0;

                document.querySelectorAll("#itemsTable tbody tr").forEach(row => {

                    let qty = parseFloat(row.querySelector(".qty")?.value) || 0;
                    let price = parseFloat(row.querySelector(".price")?.value) || 0;

                    let total = qty * price;

                    row.querySelector(".total").value = total.toFixed(2);

                    net += total;
                });

                let taxRate = parseFloat(document.getElementById("taxRate").value) || 0;

                let tax = net * (taxRate / 100);
                let gross = net + tax;

                document.getElementById("taxLabel").innerText = `MwSt (${taxRate}%)`;

                document.getElementById("netTotal").innerText = net.toFixed(2) + " €";
                document.getElementById("taxTotal").innerText = tax.toFixed(2) + " €";
                document.getElementById("grossTotal").innerText = gross.toFixed(2) + " €";
            }

            calculate();
        });
    </script>

}
