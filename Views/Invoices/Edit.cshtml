@model BauFlow.Entities.Invoice

@{
    ViewData["Title"] = "Измени фактура";
}
<link href="~/css/siteUser.css" rel="stylesheet" />

<div class="page-card w-100" style="max-width:none;">

    <h4 class="mb-4">Измени фактура</h4>

    <form asp-action="Edit" method="post">

        <input type="hidden" asp-for="Id" />

        <!-- ================== Општо ================== -->
        <div class="section-title">Општо</div>

        <div class="row g-3 mb-4">

            <div class="col-md-6">
                <div class="form-floating">
                    <select asp-for="CustomerId"
                            asp-items="ViewBag.CustomerId"
                            class="form-select"></select>
                    <label>Клиент</label>
                </div>
            </div>

            <div class="col-md-6">
                <div class="form-floating">
                    <input asp-for="InvoiceNumber" class="form-control" />
                    <label>Број на фактура</label>
                </div>
            </div>

            <div class="col-md-4">
                <div class="form-floating">
                    <input asp-for="InvoiceDate" type="date" class="form-control" />
                    <label>Датум на фактура</label>
                </div>
            </div>

            <div class="col-md-4">
                <div class="form-floating">
                    <input asp-for="DueDate" type="date" class="form-control" />
                    <label>Рок на плаќање</label>
                </div>
            </div>

            <div class="col-md-4">
                <div class="form-floating">
                    <select asp-for="Status"
                            asp-items="Html.GetEnumSelectList<BauFlow.Entities.InvoiceStatus>()"
                            class="form-select"></select>
                    <label>Статус</label>
                </div>
            </div>

        </div>

        <!-- ================== Опис ================== -->
        <div class="section-title">Опис</div>

        <div class="mb-4">
            <div class="form-floating">
                <textarea asp-for="Description"
                          class="form-control"
                          style="height: 120px"></textarea>
                <label>Текст на фактура / напомени</label>
            </div>
        </div>

        <!-- ================== Ставки ================== -->
        <div class="section-title">Ставки</div>

        <table class="table table-editor align-middle" id="itemsTable">
            <thead>
                <tr>
                    <th>Опис</th>
                    <th>Количина</th>
                    <th>Единица</th>
                    <th>Цена</th>
                    <th>Вкупно</th>
                    <th></th>
                </tr>
            </thead>

            <tbody>
                @for (int i = 0; i < Model.Items.Count; i++)
                {
                    <tr>
                        <td>
                            <input name="Items[@i].Description"
                                   value="@Model.Items.ElementAt(i).Description"
                                   class="form-control" />
                        </td>

                        <td>
                            <input type="number" step="0.01"
                                   name="Items[@i].Quantity"
                                   value="@Model.Items.ElementAt(i).Quantity.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)"
                                   class="form-control qty" />
                        </td>

                        <td>
                            <input name="Items[@i].Unit"
                                   value="@Model.Items.ElementAt(i).Unit"
                                   class="form-control" />
                        </td>

                        <td>
                            <input type="number" step="0.01"
                                   name="Items[@i].UnitPrice"
                                   value="@Model.Items.ElementAt(i).UnitPrice.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)"
                                   class="form-control price" />
                        </td>

                        <td>
                            <input type="number" step="0.01"
                                   name="Items[@i].TotalPrice"
                                   value="@Model.Items.ElementAt(i).TotalPrice.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)"
                                   class="form-control total" readonly />
                        </td>

                        <td>
                            <button type="button" class="btn btn-ghost removeRow">x</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <button type="button" id="addRow" class="btn btn-ghost mb-4">
            + Додади ставка
        </button>

        <!-- ================== РЕЗИМЕ ================== -->
        <div class="row justify-content-end">

            <div class="col-md-4">

                <div class="summary-box">

                    <div class="form-floating mb-3">
                        <select asp-for="TaxRate"
                                asp-items="ViewBag.TaxRates"
                                class="form-select"
                                id="taxRate">
                        </select>
                        <label>Даночна стапка</label>
                    </div>

                    <div class="summary-row">
                        <span>Нето</span>
                        <strong id="netTotal">@Model.NetAmount МКД</strong>
                    </div>

                    <div class="summary-row">
                        <span id="taxLabel">ДДВ (@Model.TaxRate%)</span>
                        <strong id="taxTotal">@Model.TaxAmount МКД</strong>
                    </div>

                    <div class="summary-total d-flex justify-content-between">
                        <span>Вкупно</span>
                        <span id="grossTotal">@Model.GrossAmount МКД</span>
                    </div>

                </div>

            </div>

        </div>

        <button class="btn btn-primary-custom w-100 mt-4">
            Зачувај
        </button>

    </form>

</div>

@section Scripts {
    <script>

        document.addEventListener("DOMContentLoaded", function () {

            const tbody = document.querySelector("#itemsTable tbody");
            const taxRateEl = document.getElementById("taxRate");

            let rowIndex = tbody.querySelectorAll("tr").length;

            function parseNumber(val) {
                if (!val) return 0;
                return parseFloat(val.toString().replace(",", ".")) || 0;
            }

            function formatCurrency(val) {
                return val.toFixed(2) + " МКД";
            }

            function calculate() {

                let net = 0;

                tbody.querySelectorAll("tr").forEach(row => {

                    const qty = parseNumber(row.querySelector(".qty")?.value);
                    const price = parseNumber(row.querySelector(".price")?.value);

                    const total = qty * price;

                    const totalInput = row.querySelector(".total");
                    if (totalInput) totalInput.value = total.toFixed(2);

                    net += total;
                });

                const taxRate = parseNumber(taxRateEl?.value);
                const tax = net * taxRate / 100;
                const gross = net + tax;

                document.getElementById("netTotal").innerText = formatCurrency(net);
                document.getElementById("taxTotal").innerText = formatCurrency(tax);
                document.getElementById("grossTotal").innerText = formatCurrency(gross);
                document.getElementById("taxLabel").innerText = `ДДВ (${taxRate}%)`;
            }

            // ➕ ADD ROW
            document.getElementById("addRow").addEventListener("click", function () {

                const row = `
                <tr>
                    <td><input name="Items[${rowIndex}].Description" class="form-control"/></td>
                    <td><input type="number" step="0.01" value="1" name="Items[${rowIndex}].Quantity" class="form-control qty"/></td>
                    <td><input name="Items[${rowIndex}].Unit" value="бр." class="form-control"/></td>
                    <td><input type="number" step="0.01" value="0" name="Items[${rowIndex}].UnitPrice" class="form-control price"/></td>
                    <td><input type="number" step="0.01" value="0" name="Items[${rowIndex}].TotalPrice" class="form-control total" readonly/></td>
                    <td><button type="button" class="btn btn-ghost removeRow">x</button></td>
                </tr>`;

                tbody.insertAdjacentHTML("beforeend", row);
                rowIndex++;

                calculate();
            });

            // ❌ REMOVE
            document.addEventListener("click", function (e) {
                if (e.target.classList.contains("removeRow")) {
                    e.target.closest("tr").remove();
                    calculate();
                }
            });

            // 🔄 LIVE INPUT
            document.addEventListener("input", function (e) {
                if (e.target.classList.contains("qty") || e.target.classList.contains("price")) {
                    calculate();
                }
            });

            // TAX CHANGE
            taxRateEl?.addEventListener("change", calculate);

            // INIT
            calculate();

        });
    </script>
}