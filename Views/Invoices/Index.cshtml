@model IEnumerable<BauFlow.Entities.Invoice>

@{
    ViewData["Title"] = "Фактури";
}

<link href="~/css/siteUser.css" rel="stylesheet" />


<div class="page-card w-100" style="max-width:none;">
    <div class="d-flex justify-content-between align-items-center mb-4">

        <h4>Фактури</h4>

        <div class="d-flex gap-2">

            <a asp-action="Create" class="btn btn-dark">
                + Нова фактура
            </a>

            @if (User.IsInRole("Owner"))
            {
                <button type="button"
                        class="btn btn-dark"
                        id="btnInvoiceText">
                    + Текст за фактура
                </button>
            }

        </div>

    </div>

    <div class="mb-4">
        <input type="text"
               id="searchInput"
               class="form-control search-box"
               placeholder="Пребарај фактури..." />
    </div>

    <table class="table align-middle">

        <thead>

            <tr>
                <th>Бр.</th>
                <th>Клиент</th>
                <th>Датум</th>
                <th>Статус</th>
                <th>Износ</th>
                <th></th>
            </tr>

        </thead>

        <tbody id="invoiceTable">

            @foreach (var invoice in Model)
            {

                <tr>

                    <td>@invoice.InvoiceNumber</td>

                    <td>@invoice.Customer?.Name</td>

                    <td>@invoice.InvoiceDate.ToString("dd.MM.yyyy")</td>

                    <td>@invoice.Status.GetDisplayName()</td>

                    <td>@invoice.GrossAmount</td>

                    <td>

                        <a asp-action="Details"
                               asp-route-id="@invoice.Id"
                               class="btn btn-ghost">
                            Детали
                        </a>

                    </td>

                </tr>

            }

        </tbody>

    </table>

</div>
<div class="modal fade" id="invoiceTextModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content" id="invoiceTextModalContent">
        </div>
    </div>
</div>
@section Scripts {
    <script>

        document.getElementById("btnInvoiceText")
        .addEventListener("click", async function () {

            const response = await fetch(
                '@Url.Action("SetInvoiceText", "Invoices")'
            );

            const html = await response.text();

            document.getElementById(
                "invoiceTextModalContent"
            ).innerHTML = html;

            const modal = new bootstrap.Modal(
                document.getElementById("invoiceTextModal")
            );

            modal.show();

        });

    </script>
    <script>

        const searchInput = document.getElementById("searchInput");
        const rows = document.querySelectorAll("#invoiceTable tr");

        searchInput.addEventListener("keyup", function () {

            const value = this.value.toLowerCase();

            rows.forEach(row => {

                const text = row.innerText.toLowerCase();

                row.style.display = text.includes(value) ? "" : "none";

            });

        });

    </script>

}