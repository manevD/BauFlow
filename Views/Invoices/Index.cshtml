@model IEnumerable<BauFlow.Entities.Invoice>

@{
    ViewData["Title"] = "Фактури";
}

<link href="~/css/siteUser.css" rel="stylesheet" />


<div class="page-card w-100" style="max-width:none;">
    <div class="d-flex justify-content-between mb-4">

        <h4>Фактури</h4>

        <a asp-action="Create" class="btn btn-dark">
            + Нова фактура
        </a>

    </div>

    <div class="mb-4">
        <input type="text"
               id="searchInput"
               class="form-control search-box"
               placeholder="Пребарај фактури..." />
    </div>

    <table class="table align-middle">

        <thead>

            <tr>
                <th>Бр.</th>
                <th>Клиент</th>
                <th>Датум</th>
                <th>Статус</th>
                <th>Износ</th>
                <th></th>
            </tr>

        </thead>

        <tbody id="invoiceTable">

            @foreach (var invoice in Model)
            {

                <tr>

                    <td>@invoice.InvoiceNumber</td>

                    <td>@invoice.Customer?.Name</td>

                    <td>@invoice.InvoiceDate.ToString("dd.MM.yyyy")</td>

                    <td>@invoice.Status.GetDisplayName()</td>

                    <td>@invoice.GrossAmount</td>

                    <td>

                        <a asp-action="Details"
                               asp-route-id="@invoice.Id"
                               class="btn btn-ghost">
                            Детали
                        </a>

                    </td>

                </tr>

            }

        </tbody>

    </table>

</div>

@section Scripts {

    <script>

        const searchInput = document.getElementById("searchInput");
        const rows = document.querySelectorAll("#invoiceTable tr");

        searchInput.addEventListener("keyup", function () {

            const value = this.value.toLowerCase();

            rows.forEach(row => {

                const text = row.innerText.toLowerCase();

                row.style.display = text.includes(value) ? "" : "none";

            });

        });

    </script>

}