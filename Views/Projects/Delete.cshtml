@model BauFlow.Entities.Project

<link href="~/css/siteUser.css" rel="stylesheet" />



<div class="container-fluid py-4">

    <div class="page-card">

        <h4 class="mb-4">Избриши проект</h4>

        <div class="warning-box">
            Овој проект ќе биде трајно избришан. Оваа акција не може да се поништи.
        </div>


        <div class="info-row row">
            <div class="col-4 label">Име на проект</div>
            <div class="col-8 value">@Model.Title</div>
        </div>

        <div class="info-row row">
            <div class="col-4 label">Клиент</div>
            <div class="col-8 value">@Model.Customer?.Name</div>
        </div>

        <div class="info-row row">
            <div class="col-4 label">Статус</div>
            <div class="col-8 value">@Model.Status</div>
        </div>

        <div class="info-row row">
            <div class="col-4 label">Креирано</div>
            <div class="col-8 value">@Model.CreatedAt.ToString("dd.MM.yyyy")</div>
        </div>


        <form asp-action="Delete" method="post" class="mt-4">

            <input type="hidden" asp-for="Id" />

            <div class="d-flex gap-3">

                <button type="submit" class="btn btn-danger-custom">
                    Избриши проект
                </button>

                <a asp-action="Index" class="btn btn-light-custom">
                    Откажи
                </a>

            </div>

        </form>

    </div>

</div>