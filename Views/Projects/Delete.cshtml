@model BauFlow.Entities.Project

<style>

    .page-card {
        background: #fff;
        border: 1px solid #eceef2;
        border-radius: 20px;
        box-shadow: 0 8px 24px rgba(0,0,0,.04);
        padding: 30px;
        max-width: 700px;
        margin: auto;
    }

    .warning-box {
        background: #fff5f5;
        border: 1px solid #ffe3e3;
        color: #c92a2a;
        border-radius: 12px;
        padding: 14px;
        margin-bottom: 20px;
        font-size: 14px;
    }

    .info-row {
        border-bottom: 1px solid #f1f1f1;
        padding: 12px 0;
    }

    .label {
        font-weight: 500;
        color: #666;
    }

    .value {
        color: #111;
    }

    .btn-danger-custom {
        background: #111;
        color: #fff;
        border: none;
        border-radius: 12px;
        padding: 8px 16px;
    }

        .btn-danger-custom:hover {
            background: #000;
        }

    .btn-light-custom {
        background: #f6f7f9;
        border: none;
        border-radius: 12px;
        padding: 8px 16px;
    }

        .btn-light-custom:hover {
            background: #eceef2;
        }

</style>


<div class="container-fluid py-4">

    <div class="page-card">

        <h4 class="mb-4">Projekt löschen</h4>

        <div class="warning-box">
            Dieses Projekt wird dauerhaft gelöscht. Diese Aktion kann nicht rückgängig gemacht werden.
        </div>


        <div class="info-row row">
            <div class="col-4 label">Projektname</div>
            <div class="col-8 value">@Model.Title</div>
        </div>

        <div class="info-row row">
            <div class="col-4 label">Kunde</div>
            <div class="col-8 value">@Model.Customer?.Name</div>
        </div>

        <div class="info-row row">
            <div class="col-4 label">Status</div>
            <div class="col-8 value">@Model.Status</div>
        </div>

        <div class="info-row row">
            <div class="col-4 label">Erstellt</div>
            <div class="col-8 value">@Model.CreatedAt.ToString("dd.MM.yyyy")</div>
        </div>


        <form asp-action="Delete" method="post" class="mt-4">

            <input type="hidden" asp-for="Id" />

            <div class="d-flex gap-3">

                <button type="submit" class="btn btn-danger-custom">
                    Projekt löschen
                </button>

                <a asp-action="Index" class="btn btn-light-custom">
                    Abbrechen
                </a>

            </div>

        </form>

    </div>

</div>