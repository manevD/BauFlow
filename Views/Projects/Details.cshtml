@model BauFlow.Entities.Project

<link href="~/css/siteUser.css" rel="stylesheet" />


<div class="container-fluid py-4">

    <div class="page-card w-100" style="max-width:none;">

        <!-- HEADER -->
        <div class="d-flex justify-content-between align-items-center mb-4">

            <div class="d-flex align-items-center gap-3">

                <div class="avatar-lg">
                    @Model.Title.Substring(0, 1).ToUpper()
                </div>

                <div>
                    <h4 class="mb-0">@Model.Title</h4>
                    <small class="text-muted">
                        Клиент: @Model.Customer?.Name
                    </small>
                </div>

            </div>

            <div class="d-flex gap-2">

                <a asp-action="Edit"
                       asp-route-id="@Model.Id"
                       class="btn btn-dark-custom">
                    Измени
                </a>

                <a asp-action="Index"
                       class="btn btn-light-custom">
                    Назад
                </a>

            </div>

        </div>


        <!-- INFO -->
        <div class="row">

            <div class="col-lg-6">

                <div class="info-row row">
                    <div class="col-4 label">Име на проект</div>
                    <div class="col-8 value">@Model.Title</div>
                </div>

                <div class="info-row row">
                    <div class="col-4 label">Клиент</div>
                    <div class="col-8 value">@Model.Customer?.Name</div>
                </div>

                <div class="info-row row">
                    <div class="col-4 label">Статус</div>
                    <div class="col-8 value">
                        <span class="status-pill">@Model.Status</span>
                    </div>
                </div>

                <div class="info-row row">
                    <div class="col-4 label">Креирано</div>
                    <div class="col-8 value">
                        @Model.CreatedAt.ToString("dd.MM.yyyy")
                    </div>
                </div>

            </div>

            <div class="col-lg-6">

                <div class="info-row">
                    <div class="label mb-1">Опис</div>
                    <div class="value">
                        @(string.IsNullOrWhiteSpace(Model.Description)
                        ? "Нема опис."
                        : Model.Description)
                    </div>
                </div>

            </div>

        </div>

    </div>

</div>