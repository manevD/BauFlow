@model BauFlow.Entities.Project

<link href="~/css/siteUser.css" rel="stylesheet" />

<div class="d-flex justify-content-center">

    <div class="profile-card">

        <h4 class="mb-4 text-center">Измени проект</h4>

        <div class="info-box">
            Промени ги податоците или статусот на проектот.
        </div>

        <form asp-action="Edit" method="post">

            <input type="hidden" asp-for="Id" />

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3 text-center"></div>


            <!-- Клиент -->
            <div class="form-floating mb-3">
                <select asp-for="CustomerId"
                        class="form-control"
                        asp-items="ViewBag.CustomerId">
                </select>
                <label asp-for="CustomerId">Клиент</label>
            </div>


            <!-- Наслов -->
            <div class="form-floating mb-3">
                <input asp-for="Title"
                       class="form-control"
                       placeholder="Име на проект" />
                <label asp-for="Title">Име на проект</label>
                <span asp-validation-for="Title"
                      class="text-danger small"></span>
            </div>


            <!-- Опис -->
            <div class="form-floating mb-3">
                <textarea asp-for="Description"
                          class="form-control"
                          style="height:100px"
                          placeholder="Опис"></textarea>
                <label asp-for="Description">Опис</label>
            </div>


            <!-- Статус -->
            <div class="form-floating mb-4">
                <select asp-for="Status" class="form-control">
                    <option value="Отворен">Отворен</option>
                    <option value="Во тек">Во тек</option>
                    <option value="Завршен">Завршен</option>
                </select>
                <label asp-for="Status">Статус</label>
            </div>


            <div class="d-flex gap-3">

                <button type="submit"
                        class="btn btn-primary flex-fill">
                    Зачувај измени
                </button>

                <a asp-action="Index"
                       class="btn btn-secondary-custom flex-fill">
                    Откажи
                </a>

            </div>

        </form>

    </div>

</div>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}