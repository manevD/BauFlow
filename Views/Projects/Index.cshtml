@model IEnumerable<BauFlow.Entities.Project>

@{
    ViewData["Title"] = "Проекти";
}

<style>

    .page-card {
        background: #fff;
        border: 1px solid #eceef2;
        border-radius: 20px;
        box-shadow: 0 8px 24px rgba(0,0,0,.04);
        padding: 32px;
    }

    .btn-primary-custom {
        background: #111;
        border: none;
        color: #fff;
        border-radius: 12px;
        font-weight: 600;
        padding: 8px 16px;
        font-size: 14px;
    }

        .btn-primary-custom:hover {
            background: #000;
        }

    .btn-ghost {
        background: #f6f7f9;
        border: none;
        border-radius: 10px;
        padding: 6px 12px;
        font-size: 13px;
    }

        .btn-ghost:hover {
            background: #eceef2;
        }

    .status-pill {
        background: #f6f7f9;
        border-radius: 20px;
        padding: 5px 10px;
        font-size: 12px;
    }

    thead {
        background: #fafafa;
    }

    th {
        font-weight: 600;
        font-size: 14px;
    }

    tbody tr:hover {
        background: #f9f9fb;
    }

    td {
        vertical-align: middle;
        font-size: 14px;
    }

    .avatar {
        width: 34px;
        height: 34px;
        border-radius: 50%;
        background: #111;
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 13px;
        font-weight: 600;
    }

    .search-box {
        max-width: 320px;
    }

</style>


<div class="page-card">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <h4 class="mb-0">Проекти</h4>

        <a asp-action="Create" class="btn btn-primary-custom">
            + Креирај проект
        </a>

    </div>


    <div class="mb-4">
        <input type="text"
               id="searchInput"
               class="form-control search-box"
               placeholder="Пребарај проекти..." />
    </div>


    <table class="table align-middle">

        <thead>
            <tr>
                <th></th>
                <th>Проект</th>
                <th>Клиент</th>
                <th>Статус</th>
                <th>Креирано</th>
                <th class="text-end">Акции</th>
            </tr>
        </thead>

        <tbody id="projectTable">

            @foreach (var project in Model)
            {
                <tr>

                    <td>
                        <div class="avatar">
                            @project.Title.Substring(0, 1).ToUpper()
                        </div>
                    </td>

                    <td>
                        <strong>@project.Title</strong>
                        <br />
                        <small class="text-muted">@project.Description</small>
                    </td>

                    <td>
                        @project.Customer?.Name
                    </td>

                    <td>
                        <span class="status-pill">
                            @project.Status
                        </span>
                    </td>

                    <td>
                        @project.CreatedAt.ToString("dd.MM.yyyy")
                    </td>

                    <td class="text-end">

                        <a asp-action="Edit"
                               asp-route-id="@project.Id"
                               class="btn btn-ghost me-2">
                            Измени
                        </a>

                        <a asp-action="Details"
                               asp-route-id="@project.Id"
                               class="btn btn-ghost me-2">
                            Детали
                        </a>

                        <a asp-action="Delete"
                               asp-route-id="@project.Id"
                               class="btn btn-ghost">
                            Избриши
                        </a>

                    </td>

                </tr>
            }

        </tbody>

    </table>

</div>


@section Scripts {

    <script>

        const searchInput = document.getElementById("searchInput");
        const rows = document.querySelectorAll("#projectTable tr");

        searchInput.addEventListener("keyup", function () {

            const value = this.value.toLowerCase();

            rows.forEach(row => {

                const text = row.innerText.toLowerCase();

                row.style.display = text.includes(value) ? "" : "none";

            });

        });

    </script>

}