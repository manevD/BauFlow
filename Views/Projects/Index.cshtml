@model IEnumerable<BauFlow.Entities.Project>

@{
    ViewData["Title"] = "Проекти";
}

<link href="~/css/siteUser.css" rel="stylesheet" />

<div class="page-card w-100" style="max-width:none;">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <h4 class="mb-0">Проекти</h4>

        <a asp-action="Create" class="btn btn-primary-custom">
            + Креирај проект
        </a>

    </div>


    <div class="mb-4">
        <input type="text"
               id="searchInput"
               class="form-control search-box"
               placeholder="Пребарај проекти..." />
    </div>


    <table class="table align-middle">

        <thead>
            <tr>
                <th></th>
                <th>Проект</th>
                <th>Клиент</th>
                <th>Статус</th>
                <th>Креирано</th>
                <th class="text-end">Акции</th>
            </tr>
        </thead>

        <tbody id="projectTable">

            @foreach (var project in Model)
            {
                <tr>

                    <td>
                        <div class="avatar">
                            @project.Title.Substring(0, 1).ToUpper()
                        </div>
                    </td>

                    <td>
                        <strong>@project.Title</strong>
                        <br />
                        <small class="text-muted">@project.Description</small>
                    </td>

                    <td>
                        @project.Customer?.Name
                    </td>

                    <td>
                        <span class="status-pill">
                            @project.Status
                        </span>
                    </td>

                    <td>
                        @project.CreatedAt.ToString("dd.MM.yyyy")
                    </td>

                    <td class="text-end">

                        <a asp-action="Edit"
                               asp-route-id="@project.Id"
                               class="btn btn-ghost me-2">
                            Измени
                        </a>

                        <a asp-action="Details"
                               asp-route-id="@project.Id"
                               class="btn btn-ghost me-2">
                            Детали
                        </a>

                        <a asp-action="Delete"
                               asp-route-id="@project.Id"
                               class="btn btn-ghost-danger">
                            Избриши
                        </a>

                    </td>

                </tr>
            }

        </tbody>

    </table>

</div>


@section Scripts {

    <script>

        const searchInput = document.getElementById("searchInput");
        const rows = document.querySelectorAll("#projectTable tr");

        searchInput.addEventListener("keyup", function () {

            const value = this.value.toLowerCase();

            rows.forEach(row => {

                const text = row.innerText.toLowerCase();

                row.style.display = text.includes(value) ? "" : "none";

            });

        });

    </script>

}