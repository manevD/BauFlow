@model BauFlow.Entities.Quote

<style>
    .page-card {
        background: #fff;
        border: 1px solid #eceef2;
        border-radius: 20px;
        box-shadow: 0 8px 24px rgba(0,0,0,.04);
        padding: 32px;
    }

    .btn-primary-custom {
        background: #111;
        border: none;
        color: #fff;
        border-radius: 12px;
        padding: 10px 16px;
        font-weight: 600;
    }

        .btn-primary-custom:hover {
            background: #000;
        }

    .btn-ghost {
        background: #f6f7f9;
        border: none;
        border-radius: 10px;
        padding: 6px 12px;
    }

        .btn-ghost:hover {
            background: #eceef2;
        }

    thead {
        background: #fafafa;
    }

    .summary-box {
        background: #f6f7f9;
        border-radius: 16px;
        padding: 20px;
    }

    .summary-row {
        display: flex;
        justify-content: space-between;
        margin-bottom: 10px;
    }

    .summary-total {
        font-weight: 700;
        font-size: 18px;
        border-top: 1px solid #ddd;
        padding-top: 10px;
    }
</style>

<div class="page-card">

    <div class="d-flex justify-content-between mb-4">
        <h4>Нова понуда</h4>
        <a asp-action="Index" class="btn btn-ghost">Назад</a>
    </div>

    <form asp-action="Create" method="post">

        <div class="row">
            <div class="col-md-6">
                <div class="form-floating mb-3">
                    <select asp-for="CustomerId"
                            asp-items="ViewBag.CustomerId"
                            class="form-control"></select>
                    <label>Клиент</label>
                </div>
            </div>

            <div class="col-md-6">
                <div class="form-floating mb-4">
                    <input asp-for="ValidUntil" type="date" class="form-control" />
                    <label>Важи до</label>
                </div>
            </div>
        </div>

        <hr class="mb-4" />

        <h5 class="mb-3">Ставки</h5>

        <table class="table align-middle" id="itemsTable">
            <thead>
                <tr>
                    <th>Опис</th>
                    <th width="120">Количина</th>
                    <th width="120">Единица</th>
                    <th width="140">Цена</th>
                    <th width="140">Вкупно</th>
                    <th></th>
                </tr>
            </thead>

            <tbody>
                <tr>
                    <td><input name="Items[0].Description" class="form-control" /></td>
                    <td><input type="number" step="0.01" value="0" name="Items[0].Quantity" class="form-control qty" /></td>
                    <td><input name="Items[0].Unit" class="form-control" /></td>
                    <td><input type="number" step="0.01" value="0" name="Items[0].UnitPrice" class="form-control price" /></td>
                    <td><input type="text" value="0" name="Items[0].TotalPrice" class="form-control total" readonly /></td>
                    <td><button type="button" class="btn btn-ghost removeRow">x</button></td>
                </tr>
            </tbody>
        </table>

        <button type="button" id="addRow" class="btn btn-ghost mb-4">
            + Додади ставка
        </button>

        <div class="row justify-content-end">
            <div class="col-md-4">
                <div class="summary-box">

                    <div class="form-floating mb-3">
                        <select asp-for="TaxRate"
                                asp-items="ViewBag.TaxRates"
                                class="form-select"
                                id="taxRate"></select>
                        <label>Даночна стапка</label>
                    </div>

                    <div class="summary-row">
                        <span>Нето</span>
                        <strong id="netTotal">0 МКД</strong>
                    </div>

                    <div class="summary-row">
                        <span id="taxLabel">ДДВ (0%)</span>
                        <strong id="taxTotal">0 МКД</strong>
                    </div>

                    <div class="summary-total d-flex justify-content-between">
                        <span>Вкупно</span>
                        <span id="grossTotal">0 МКД</span>
                    </div>

                </div>
            </div>
        </div>

        <button class="btn btn-primary-custom w-100 mt-4">
            Зачувај понуда
        </button>

    </form>

</div>

@section Scripts{
<script>

document.addEventListener("DOMContentLoaded", function () {

    let rowIndex = document.querySelectorAll("#itemsTable tbody tr").length;

    const taxRateEl = document.getElementById("taxRate");

    function formatCurrency(value) {
        return value.toFixed(2) + " МКД";
    }

    function calculateTotals() {

        let net = 0;

        document.querySelectorAll("#itemsTable tbody tr").forEach(row => {

            let qty = parseFloat((row.querySelector(".qty")?.value || "0").replace(",", ".")) || 0;
            let price = parseFloat((row.querySelector(".price")?.value || "0").replace(",", ".")) || 0;

            let total = qty * price;

            let totalInput = row.querySelector(".total");
            if (totalInput) totalInput.value = total.toFixed(2);

            net += total;
        });

        let taxRate = parseFloat(taxRateEl.value) || 0;

        let tax = net * (taxRate / 100);
        let gross = net + tax;

        document.getElementById("netTotal").innerText = formatCurrency(net);
        document.getElementById("taxTotal").innerText = formatCurrency(tax);
        document.getElementById("grossTotal").innerText = formatCurrency(gross);
        document.getElementById("taxLabel").innerText = "ДДВ (" + taxRate + "%)";
    }

    // INPUT CHANGE
    document.addEventListener("input", function (e) {
        if (e.target.classList.contains("qty") || e.target.classList.contains("price")) {
            calculateTotals();
        }
    });

    // TAX CHANGE
    taxRateEl.addEventListener("change", calculateTotals);

    // ADD ROW
    document.getElementById("addRow").addEventListener("click", function () {

        let table = document.querySelector("#itemsTable tbody");

        let row = `
        <tr>
            <td><input name="Items[${rowIndex}].Description" class="form-control"/></td>
            <td><input type="number" step="0.01" value="0" name="Items[${rowIndex}].Quantity" class="form-control qty"/></td>
            <td><input name="Items[${rowIndex}].Unit" class="form-control"/></td>
            <td><input type="number" step="0.01" value="0" name="Items[${rowIndex}].UnitPrice" class="form-control price"/></td>
            <td><input type="text" value="0" name="Items[${rowIndex}].TotalPrice" class="form-control total" readonly/></td>
            <td><button type="button" class="btn btn-ghost removeRow">x</button></td>
        </tr>
        `;

        table.insertAdjacentHTML("beforeend", row);
        rowIndex++;

        calculateTotals();
    });

    // REMOVE ROW
    document.addEventListener("click", function (e) {
        if (e.target.classList.contains("removeRow")) {
            e.target.closest("tr").remove();
            calculateTotals();
        }
    });

    // INIT
    calculateTotals();
});
</script>
}