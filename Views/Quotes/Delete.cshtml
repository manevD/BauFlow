@model BauFlow.Entities.Quote

<div class="page-card">

    <h4 class="mb-4">Избриши понуда</h4>

    <div class="warning-box">

        Оваа понуда ќе биде трајно избришана.

    </div>

    <div class="info-row row">

        <div class="col-4">Бр.</div>

        <div class="col-8">@Model.QuoteNumber</div>

    </div>

    <div class="info-row row">

        <div class="col-4">Клиент</div>

        <div class="col-8">@Model.Customer?.Name</div>

    </div>

    <form asp-action="DeleteConfirmed" method="post">

        <input type="hidden" asp-for="Id" />

        <button class="btn btn-primary-custom">

            Избриши

        </button>

    </form>

</div>