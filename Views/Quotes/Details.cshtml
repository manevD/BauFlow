@model BauFlow.Entities.Quote


<link href="~/css/siteUser.css" rel="stylesheet" />


<div class="page-card w-100" style="max-width:none;">

    <div class="d-flex justify-content-between mb-4">

        <h4>Понуда @Model.QuoteNumber</h4>

        <a asp-controller="Invoices"
               asp-action="CreateFromQuote"
               asp-route-quoteId="@Model.Id"
               class="btn btn-primary-custom">

            Креирај фактура

        </a>

    </div>

    <div class="info-row row">

        <div class="col-3 label">Клиент</div>

        <div class="col-9 value">
            @Model.Customer?.Name
        </div>

    </div>

    <div class="info-row row">

        <div class="col-3 label">Датум</div>

        <div class="col-9 value">
            @Model.QuoteDate.ToString("dd.MM.yyyy")
        </div>

    </div>

    <div class="info-row row">

        <div class="col-3 label">Важи до</div>

        <div class="col-9 value">
            @Model.ValidUntil?.ToString("dd.MM.yyyy")
        </div>

    </div>

    <div class="info-row row">

        <div class="col-3 label">Статус</div>

        <div class="col-9 value">
            @Model.Status.GetDisplayName()
        </div>

    </div>

</div>