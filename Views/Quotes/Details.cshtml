@model BauFlow.Entities.Quote

<style>

    .page-card {
        background: #fff;
        border: 1px solid #eceef2;
        border-radius: 20px;
        box-shadow: 0 8px 24px rgba(0,0,0,.04);
        padding: 32px;
    }

    .info-row {
        border-bottom: 1px solid #f1f1f1;
        padding: 12px 0;
    }

    .label {
        color: #666;
    }

    .value {
        font-weight: 500;
    }

    .btn-primary-custom {
        background: #111;
        border: none;
        color: #fff;
        border-radius: 12px;
        padding: 8px 16px;
    }

        .btn-primary-custom:hover {
            background: #000;
        }

    .btn-ghost {
        background: #f6f7f9;
        border: none;
        border-radius: 10px;
        padding: 6px 12px;
    }

</style>


<div class="page-card">

    <div class="d-flex justify-content-between mb-4">

        <h4>Angebot @Model.QuoteNumber</h4>

        <a asp-controller="Invoices"
               asp-action="CreateFromQuote"
               asp-route-quoteId="@Model.Id"
               class="btn btn-primary-custom">

            Rechnung erstellen

        </a>

    </div>

    <div class="info-row row">

        <div class="col-3 label">Kunde</div>

        <div class="col-9 value">
            @Model.Customer?.Name
        </div>

    </div>

    <div class="info-row row">

        <div class="col-3 label">Datum</div>

        <div class="col-9 value">
            @Model.QuoteDate.ToString("dd.MM.yyyy")
        </div>

    </div>

    <div class="info-row row">

        <div class="col-3 label">Gültig bis</div>

        <div class="col-9 value">
            @Model.ValidUntil?.ToString("dd.MM.yyyy")
        </div>

    </div>

    <div class="info-row row">

        <div class="col-3 label">Status</div>

        <div class="col-9 value">
            @Model.Status
        </div>

    </div>

</div>