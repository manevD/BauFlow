@model BauFlow.Entities.Quote

@{
    var items = Model?.Items?.ToList() ?? new List<BauFlow.Entities.QuoteItem>();
}


<link href="~/css/siteUser.css" rel="stylesheet" />


<div class="page-card w-100" style="max-width:none;">
    <div class="d-flex justify-content-between mb-4">
        <h4>Измени понуда</h4>
        <a asp-action="Index" class="btn btn-ghost">Назад</a>
    </div>

    <form asp-action="Edit" method="post">

        <!-- Клиент + Датум -->
        <div class="row">

            <div class="col-md-6">
                <div class="form-floating mb-3">
                    <select asp-for="CustomerId"
                            asp-items="ViewBag.CustomerId"
                            class="form-select">
                    </select>
                    <label>Клиент</label>
                </div>
            </div>

            <div class="col-md-6">
                <div class="form-floating mb-3">
                    <input asp-for="ValidUntil"
                           type="date"
                           class="form-control" />
                    <label>Важи до</label>
                </div>
            </div>

        </div>

        <hr class="mb-4" />

        <!-- Ставки -->
        <h5 class="mb-3">Ставки</h5>

        <table class="table align-middle" id="itemsTable">
            <thead>
                <tr>
                    <th>Опис</th>
                    <th width="120">Количина</th>
                    <th width="120">Единица</th>
                    <th width="140">Цена</th>
                    <th width="140">Вкупно</th>
                    <th></th>
                </tr>
            </thead>

            <tbody>
                @if (items.Any())
                {
                    for (int i = 0; i < items.Count; i++)
                    {
                        <tr>
                            <td>
                                <input name="Items[@i].Id" type="hidden" value="@items[i].Id" />
                                <input type="text" name="Items[@i].Description" class="form-control" value="@items[i].Description" />
                            </td>

                            <td>
                                <input type="text" 
                                       name="Items[@i].Quantity"
                                       class="form-control qty"
                                       value="@items[i].Quantity" />
                            </td>

                            <td>
                                <input name="Items[@i].Unit" class="form-control" value="@items[i].Unit" />
                            </td>

                            <td>
                                <input type="text" 
                                       name="Items[@i].UnitPrice"
                                       class="form-control price"
                                       value="@items[i].UnitPrice" />
                            </td>

                            <td>
                                <input type="text" 
                                       name="Items[@i].TotalPrice"
                                       class="form-control total"
                                       value="@items[i].TotalPrice.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)"
                                       readonly />
                            </td>

                            <td>
                                <button type="button" class="btn btn-ghost removeRow">x</button>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td><input type="text" name="Items[0].Description" class="form-control" /></td>
                        <td><input type="text" value="0" name="Items[0].Quantity" class="form-control qty" /></td>
                        <td><input name="Items[0].Unit" class="form-control" /></td>
                        <td><input type="text" value="0" name="Items[0].UnitPrice" class="form-control price" /></td>
                        <td><input type="text" value="0" name="Items[0].TotalPrice" class="form-control total" readonly /></td>
                        <td><button type="button" class="btn btn-ghost removeRow">x</button></td>
                    </tr>
                }
            </tbody>
        </table>

        <button type="button" id="addRow" class="btn btn-ghost mb-4">
            + Додади ставка
        </button>

        <!-- Вкупно -->
        <div class="row justify-content-end">
            <div class="col-md-4">
                <div class="total-box">

                    <div class="form-floating mb-3">
                        <select asp-for="TaxRate"
                                asp-items="ViewBag.TaxRates"
                                class="form-select"
                                id="taxRate">
                        </select>
                        <label>Даночна стапка</label>
                    </div>

                    <div class="d-flex justify-content-between mb-2">
                        <span>Нето</span>
                        <strong id="netTotal">0.00 МКД</strong>
                    </div>

                    <div class="d-flex justify-content-between mb-2">
                        <span id="taxLabel">ДДВ (@Model.TaxRate%)</span>
                        <strong id="taxTotal">0.00 МКД</strong>
                    </div>

                    <hr>

                    <div class="d-flex justify-content-between">
                        <h5>Вкупно</h5>
                        <h5 id="grossTotal">0.00 МКД</h5>
                    </div>

                </div>
            </div>
        </div>

        <button class="btn btn-primary-custom w-100 mt-4">
            Зачувај понуда
        </button>

    </form>

</div>

@section Scripts {

    <script>

        document.addEventListener("DOMContentLoaded", function () {

            let rowIndex = document.querySelectorAll("#itemsTable tbody tr").length;
            if (rowIndex === 0) rowIndex = 1;

            document.getElementById("addRow").addEventListener("click", function () {

                let table = document.querySelector("#itemsTable tbody");

                let row = `
                <tr>
                    <td><input type="text" name="Items[${rowIndex}].Description" class="form-control"/></td>
                    <td><input type="text" value="0" name="Items[${rowIndex}].Quantity" class="form-control qty"/></td>
                    <td><input name="Items[${rowIndex}].Unit" class="form-control"/></td>
                    <td><input type="text"  value="0" name="Items[${rowIndex}].UnitPrice" class="form-control price"/></td>
                    <td><input type="text"  value="0" name="Items[${rowIndex}].TotalPrice" class="form-control total" readonly/></td>
                    <td><button type="button" class="btn btn-ghost removeRow">x</button></td>
                </tr>`;

                table.insertAdjacentHTML("beforeend", row);
                rowIndex++;
            });

            document.addEventListener("click", function (e) {
                if (e.target.classList.contains("removeRow")) {
                    e.target.closest("tr").remove();
                    calculateTotals();
                }
            });

            document.addEventListener("input", function (e) {
                if (e.target.classList.contains("qty") || e.target.classList.contains("price")) {
                    calculateTotals();
                }
            });

            document.getElementById("taxRate").addEventListener("change", calculateTotals);

            function calculateTotals() {

                let net = 0;

                document.querySelectorAll("#itemsTable tbody tr").forEach(row => {

                    let qty = parseFloat(row.querySelector(".qty")?.value) || 0;
                    let price = parseFloat(row.querySelector(".price")?.value) || 0;

                    let total = qty * price;

                    let totalInput = row.querySelector(".total");
                    if (totalInput) {
                        totalInput.value = total.toFixed(2);
                    }

                    net += total;
                });

                let taxRate = parseFloat(document.getElementById("taxRate").value) || 0;

                let tax = net * (taxRate / 100);
                let gross = net + tax;

                document.getElementById("taxLabel").innerText = `Данок (${taxRate}%)`;

                document.getElementById("netTotal").innerText = net.toFixed(2) + " МКД";
                document.getElementById("taxTotal").innerText = tax.toFixed(2) + " МКД";
                document.getElementById("grossTotal").innerText = gross.toFixed(2) + " МКД";
            }

            calculateTotals();
        });
    </script>

}
