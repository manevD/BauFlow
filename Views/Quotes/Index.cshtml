@model IEnumerable<BauFlow.Entities.Quote>

<style>

    .page-card {
        background: #fff;
        border: 1px solid #eceef2;
        border-radius: 20px;
        box-shadow: 0 8px 24px rgba(0,0,0,.04);
        padding: 32px;
    }

    .btn-primary-custom {
        background: #111;
        border: none;
        color: #fff;
        border-radius: 12px;
        padding: 8px 16px;
        font-weight: 600;
    }

        .btn-primary-custom:hover {
            background: #000;
        }

    .btn-ghost {
        background: #f6f7f9;
        border: none;
        border-radius: 10px;
        padding: 6px 12px;
    }

        .btn-ghost:hover {
            background: #eceef2;
        }

    thead {
        background: #fafafa;
    }

    tbody tr:hover {
        background: #f9f9fb;
    }

    .search-box {
        max-width: 320px;
    }

</style>


<div class="page-card">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <h4 class="mb-0">Понуди</h4>

        <a asp-action="Create" class="btn btn-primary-custom">
            + Креирај понуда
        </a>

    </div>

    <div class="mb-4">
        <input type="text"
               id="searchInput"
               class="form-control search-box"
               placeholder="Пребарај понуди..." />
    </div>

    <table class="table align-middle">

        <thead>

            <tr>
                <th>Бр.</th>
                <th>Клиент</th>
                <th>Датум</th>
                <th>Статус</th>
                <th>Вкупно</th>
                <th class="text-end">Акции</th>
            </tr>

        </thead>

        <tbody id="angeboteTable">

            @foreach (var quote in Model)
            {

                <tr>

                    <td>@quote.QuoteNumber</td>

                    <td>@quote.Customer?.Name</td>

                    <td>@quote.QuoteDate.ToString("dd.MM.yyyy")</td>

                    <td>@quote.Status.GetDisplayName()</td>

                    <td>@quote.GrossAmount.ToString("C")</td>

                    <td class="text-end">

                        <a asp-action="Details"
                               asp-route-id="@quote.Id"
                               class="btn btn-ghost">
                            Детали
                        </a>

                        <a asp-action="Edit"
                               asp-route-id="@quote.Id"
                               class="btn btn-ghost">
                            Измени
                        </a>

                    </td>

                </tr>

            }

        </tbody>

    </table>

</div>


@section Scripts {

    <script>

        const searchInput = document.getElementById("searchInput");
        const rows = document.querySelectorAll("#angeboteTable tr");

        searchInput.addEventListener("keyup", function () {

            const value = this.value.toLowerCase();

            rows.forEach(row => {

                const text = row.innerText.toLowerCase();

                row.style.display = text.includes(value) ? "" : "none";

            });

        });

    </script>

}