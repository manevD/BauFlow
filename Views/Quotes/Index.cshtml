@model IEnumerable<BauFlow.Entities.Quote>

<link href="~/css/siteUser.css" rel="stylesheet" />


<div class="page-card w-100" style="max-width:none;">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <h4 class="mb-0">Понуди</h4>

        <a asp-action="Create" class="btn btn-primary-custom">
            + Креирај понуда
        </a>

    </div>

    <div class="mb-4">
        <input type="text"
               id="searchInput"
               class="form-control search-box"
               placeholder="Пребарај понуди..." />
    </div>

    <table class="table align-middle">

        <thead>

            <tr>
                <th>Бр.</th>
                <th>Клиент</th>
                <th>Датум</th>
                <th>Статус</th>
                <th>Вкупно</th>
                <th class="text-end">Акции</th>
            </tr>

        </thead>

        <tbody id="angeboteTable">

            @foreach (var quote in Model)
            {

                <tr>

                    <td>@quote.QuoteNumber</td>

                    <td>@quote.Customer?.Name</td>

                    <td>@quote.QuoteDate.ToString("dd.MM.yyyy")</td>

                    <td>@quote.Status.GetDisplayName()</td>

                    <td>@quote.GrossAmount</td>

                    <td class="text-end">

                        <a asp-action="Details"
                               asp-route-id="@quote.Id"
                               class="btn btn-ghost">
                            Детали
                        </a>

                        <a asp-action="Edit"
                               asp-route-id="@quote.Id"
                               class="btn btn-ghost">
                            Измени
                        </a>
                        <a asp-action="Delete"
                               asp-route-id="@quote.Id"
                               class="btn btn-ghost-danger">
                            Избриши
                        </a>
                    </td>

                </tr>

            }

        </tbody>

    </table>

</div>


@section Scripts {

    <script>

        const searchInput = document.getElementById("searchInput");
        const rows = document.querySelectorAll("#angeboteTable tr");

        searchInput.addEventListener("keyup", function () {

            const value = this.value.toLowerCase();

            rows.forEach(row => {

                const text = row.innerText.toLowerCase();

                row.style.display = text.includes(value) ? "" : "none";

            });

        });

    </script>

}