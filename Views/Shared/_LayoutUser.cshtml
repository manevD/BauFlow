@using BauFlow.Areas.Identity.Pages.Account.Manage
<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>BauFlow</title>

    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />

    <style>
        body {
            background: #f6f7f9;
            color: #111;
            min-height: 100vh;
        }

        /* SIDEBAR */
        .sidebar {
            width: 260px;
            background: #ffffff;
            border-right: 1px solid #eceef2;
            box-shadow: 4px 0 20px rgba(0,0,0,.03);
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            position: fixed;
            top: 0;
            bottom: 0;
            left: 0;
            z-index: 1030;
        }

            .sidebar .nav-link {
                color: #444;
                border-radius: 12px;
                padding: 10px 14px;
                font-weight: 500;
                transition: all .2s ease;
            }

                .sidebar .nav-link:hover {
                    background: #f1f3f5;
                    color: #000;
                }

                .sidebar .nav-link.active {
                    background: #111;
                    color: #fff !important;
                }

        /* MAIN AREA */
        .main-area {
            margin-left: 260px;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* TOPBAR */
        .topbar {
            background: #ffffff;
            border-bottom: 1px solid #eceef2;
        }

        /* CONTENT */
        main {
            flex: 1;
            background: #f6f7f9;
        }

        .content-wrapper {
            padding: 40px 60px;
        }

        /* FOOTER */
        .footer {
            background: #ffffff;
            border-top: 1px solid #eceef2;
            color: #6b7280;
        }

        /* MOBILE */
        #sidebarToggle {
            display: none;
        }

        @@media (max-width: 991.98px) {

            .sidebar {
                left: -280px;
                transition: all .3s ease;
            }

                .sidebar.show {
                    left: 0;
                }

            .main-area {
                margin-left: 0;
            }

            #sidebarToggle {
                display: inline-block;
            }

            .overlay {
                display: none;
                position: fixed;
                inset: 0;
                background: rgba(0,0,0,.4);
                z-index: 1025;
            }

                .overlay.show {
                    display: block;
                }
        }

        h1, h2, h3, h4, h5 {
            font-weight: 600;
        }
    </style>
</head>

<body>

    <div class="d-flex">

        <!-- SIDEBAR -->
        <nav class="sidebar p-4" id="sidebar">

            <div>
                <div class="fs-4 fw-bold mb-4">BauFlow</div>

                <ul class="nav nav-pills flex-column gap-2">

                    <li class="nav-item">
                        <a asp-controller="Home" asp-action="Index"
                           class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Home" ? "active" : "")">
                            Dashboard
                        </a>
                    </li>

                    <li class="nav-item">
                        <a asp-controller="Projects" asp-action="Index"
                           class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Projects" ? "active" : "")">
                            Projekte
                        </a>
                    </li>

                    <li class="nav-item">
                        <a asp-controller="Invoices" asp-action="Index"
                           class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Invoices" ? "active" : "")">
                            Rechnungen
                        </a>
                    </li>

                    <li class="nav-item">
                        <a asp-controller="Customers" asp-action="Index"
                           class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Customers" ? "active" : "")">
                            Kunden
                        </a>
                    </li>
                    @if (User.IsInRole("Owner"))
                    {
                        <li class="nav-item">
                            <a asp-controller="Users" asp-action="Index"
                               class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Users" ? "active" : "")">
                                Benutzer
                            </a>
                        </li>
                    }


                    <li class="mt-4 text-uppercase small text-muted">Einstellungen</li>

                    <li class="nav-item">
                        <a asp-area="Identity"
                           asp-page="/Account/Manage/Index"
                           class="nav-link @(ViewContext.RouteData.Values["Page"]?.ToString()?.Contains("Manage/Index") == true ? "active" : "")">
                            Profil
                        </a>
                    </li>

                    <li class="nav-item">
                        <a asp-area="Identity"
                           asp-page="/Account/Manage/ChangePassword"
                           class="nav-link @(ViewContext.RouteData.Values["Page"]?.ToString()?.Contains("ChangePassword") == true ? "active" : "")">
                            Passwort
                        </a>
                    </li>

                    <li class="nav-item">
                        <a asp-area="Identity"
                           asp-page="/Account/Manage/Email"
                           class="nav-link @(ViewContext.RouteData.Values["Page"]?.ToString()?.Contains("Email") == true ? "active" : "")">
                            Email
                        </a>
                    </li>

                    <li class="nav-item">
                        <a asp-area="Identity"
                           asp-page="/Account/Manage/PersonalData"
                           class="nav-link @(ViewContext.RouteData.Values["Page"]?.ToString()?.Contains("PersonalData") == true ? "active" : "")">
                            Daten
                        </a>
                    </li>

                </ul>
            </div>

            <div class="mt-4">
                <form asp-area="Identity"
                      asp-page="/Account/Logout"
                      asp-route-returnUrl="/Identity/Account/Login"
                      method="post">

                    @Html.AntiForgeryToken()

                    <button type="submit" class="btn btn-outline-secondary w-100 mb-3">
                        Abmelden
                    </button>

                </form>
                <div class="footer text-center small py-3">
                    © @DateTime.Now.Year BauFlow – Alle Rechte vorbehalten
                </div>
            </div>

        </nav>

        <!-- MOBILE OVERLAY -->
        <div class="overlay" id="overlay"></div>

        <!-- MAIN AREA -->
        <div class="main-area flex-fill">

            <!-- TOPBAR -->
            <header class="topbar px-4 py-3 d-flex justify-content-between align-items-center">
                <button class="btn btn-outline-secondary d-lg-none" id="sidebarToggle">☰</button>
                <h5 class="mb-0">Willkommen bei BauFlow</h5>
                <div class="text-muted small">@User.Identity?.Name</div>
            </header>

            <!-- CONTENT -->
            <main>
                <div class="content-wrapper">
                    @RenderBody()
                </div>
            </main>

        </div>

    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        const sidebar = document.getElementById('sidebar');
        const overlay = document.getElementById('overlay');
        const toggle = document.getElementById('sidebarToggle');

        toggle.addEventListener('click', () => {
            sidebar.classList.toggle('show');
            overlay.classList.toggle('show');
        });

        overlay.addEventListener('click', () => {
            sidebar.classList.remove('show');
            overlay.classList.remove('show');
        });
    </script>

    @RenderSection("Scripts", required: false)

</body>
</html>