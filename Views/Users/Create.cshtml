@using BauFlow.Entities
@using BauFlow.ViewModels
@model UserCreateViewModel
<link href="~/css/siteUser.css" rel="stylesheet" />

<div class="d-flex justify-content-center">

    <div class="profile-card">

        <h4 class="mb-4 text-center">Покани корисник</h4>

        <div class="info-box">
            Корисникот ќе добие е-пошта со линк за покана и сам ќе може да постави лозинка.
        </div>

        <form asp-action="Create" method="post">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3 text-center"></div>

            <div class="form-floating mb-3">
                <input asp-for="Email"
                       class="form-control"
                       placeholder="Е-пошта" />
                <label asp-for="Email">Е-пошта</label>
                <span asp-validation-for="Email"
                      class="text-danger small"></span>
            </div>

            <div class="form-floating mb-4">
                <input asp-for="FullName"
                       class="form-control"
                       placeholder="Целосно име" />
                <label asp-for="FullName">Целосно име</label>
            </div>

            <input type="hidden" asp-for="CompanyId" />

            <button type="submit"
                    class="btn btn-primary-custom w-100">
                Испрати покана
            </button>

        </form>

    </div>

</div>