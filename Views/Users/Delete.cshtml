@model BauFlow.Entities.ApplicationUser

<link href="~/css/siteUser.css" rel="stylesheet" />

<div class="container-fluid py-4">

    <div class="page-card">

        <h4 class="mb-4">Избриши корисник</h4>

        <div class="warning-box">
            Овој корисник ќе биде трајно избришан и веднаш ќе го изгуби пристапот до BauFlow.
        </div>


        <div class="info-row row">
            <div class="col-4 label">Име</div>
            <div class="col-8 value">
                @(string.IsNullOrWhiteSpace(Model.FullName) ? "-" : Model.FullName)
            </div>
        </div>


        <div class="info-row row">
            <div class="col-4 label">Е-пошта</div>
            <div class="col-8 value">@Model.Email</div>
        </div>


        <div class="info-row row">
            <div class="col-4 label">Статус</div>
            <div class="col-8 value">

                @if (Model.IsInviteAccepted)
                {
                    <span class="status-pill status-active">Активен</span>
                }
                else
                {
                    <span class="status-pill status-pending">Поканата е отворена</span>
                }

            </div>
        </div>


        <form asp-action="Delete" method="post" class="mt-4">

            <input type="hidden" asp-for="Id" />

            <div class="d-flex gap-3">

                <button type="submit" class="btn btn-danger-custom">
                    Избриши корисник
                </button>

                <a asp-action="Index" class="btn btn-light-custom">
                    Откажи
                </a>

            </div>

        </form>

    </div>

</div>