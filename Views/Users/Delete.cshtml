@model BauFlow.Entities.ApplicationUser

<style>

    .page-card {
        background: #fff;
        border: 1px solid #eceef2;
        border-radius: 20px;
        box-shadow: 0 8px 24px rgba(0,0,0,.04);
        padding: 30px;
        max-width: 700px;
        margin: auto;
    }

    .warning-box {
        background: #fff5f5;
        border: 1px solid #ffe3e3;
        color: #c92a2a;
        border-radius: 12px;
        padding: 14px;
        margin-bottom: 20px;
        font-size: 14px;
    }

    .info-row {
        border-bottom: 1px solid #f1f1f1;
        padding: 12px 0;
    }

    .label {
        font-weight: 500;
        color: #666;
    }

    .value {
        color: #111;
    }

    .btn-danger-custom {
        background: #111;
        color: #fff;
        border: none;
        border-radius: 12px;
        padding: 8px 16px;
    }

        .btn-danger-custom:hover {
            background: #000;
        }

    .btn-light-custom {
        background: #f6f7f9;
        border: none;
        border-radius: 12px;
        padding: 8px 16px;
    }

        .btn-light-custom:hover {
            background: #eceef2;
        }

    .status-pill {
        border-radius: 20px;
        padding: 5px 10px;
        font-size: 12px;
    }

    .status-active {
        background: #111;
        color: #fff;
    }

    .status-pending {
        background: #f6f7f9;
        color: #555;
    }

</style>


<div class="container-fluid py-4">

    <div class="page-card">

        <h4 class="mb-4">Benutzer löschen</h4>

        <div class="warning-box">
            Dieser Benutzer wird dauerhaft gelöscht und verliert sofort den Zugriff auf BauFlow.
        </div>


        <div class="info-row row">
            <div class="col-4 label">Name</div>
            <div class="col-8 value">
                @(string.IsNullOrWhiteSpace(Model.FullName) ? "-" : Model.FullName)
            </div>
        </div>


        <div class="info-row row">
            <div class="col-4 label">Email</div>
            <div class="col-8 value">@Model.Email</div>
        </div>


        <div class="info-row row">
            <div class="col-4 label">Status</div>
            <div class="col-8 value">

                @if (Model.IsInviteAccepted)
                {
                    <span class="status-pill status-active">Aktiv</span>
                }
                else
                {
                    <span class="status-pill status-pending">Einladung offen</span>
                }

            </div>
        </div>


        <form asp-action="Delete" method="post" class="mt-4">

            <input type="hidden" asp-for="Id" />

            <div class="d-flex gap-3">

                <button type="submit" class="btn btn-danger-custom">
                    Benutzer löschen
                </button>

                <a asp-action="Index" class="btn btn-light-custom">
                    Abbrechen
                </a>

            </div>

        </form>

    </div>

</div>