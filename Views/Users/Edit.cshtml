@using BauFlow.ViewModels;
@model BauFlow.Entities.ApplicationUser

<link href="~/css/siteUser.css" rel="stylesheet" />

<div class="d-flex justify-content-center">

    <div class="profile-card">

        <h4 class="mb-4 text-center">Измени корисник</h4>

        <form asp-action="Edit" method="post">

            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="CompanyId" />

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3 text-center"></div>

            <div class="form-floating mb-3">
                <input asp-for="Email"
                       class="form-control"
                       placeholder="Е-пошта" />
                <label asp-for="Email">Е-пошта</label>
                <span asp-validation-for="Email"
                      class="text-danger small"></span>
            </div>

            <div class="form-floating mb-3">
                <input asp-for="FullName"
                       class="form-control"
                       placeholder="Целосно име" />
                <label asp-for="FullName">Целосно име</label>
            </div>

            <div class="d-flex gap-3">

                <button type="submit"
                        class="btn btn-primary flex-fill">
                    Зачувај измени
                </button>

                <a asp-action="Index"
                       class="btn btn-secondary-custom flex-fill">
                    Откажи
                </a>

            </div>

        </form>

    </div>

</div>