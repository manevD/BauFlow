@model IEnumerable<BauFlow.Entities.ApplicationUser>

@{
    ViewData["Title"] = "Корисници";
}

<style>

    .page-card {
        background: #fff;
        border: 1px solid #eceef2;
        border-radius: 20px;
        box-shadow: 0 8px 24px rgba(0,0,0,.04);
        padding: 32px;
    }

    .btn-primary-custom {
        background: #111;
        border: none;
        color: #fff;
        border-radius: 12px;
        font-weight: 600;
        padding: 8px 16px;
        font-size: 14px;
    }

        .btn-primary-custom:hover {
            background: #000;
        }

    .btn-ghost {
        background: #f6f7f9;
        border: none;
        border-radius: 10px;
        padding: 6px 12px;
        font-size: 13px;
    }

        .btn-ghost:hover {
            background: #eceef2;
        }

    .btn-danger-ghost {
        background: #fafafa;
        border: none;
        border-radius: 10px;
        padding: 6px 12px;
        font-size: 13px;
    }

        .btn-danger-ghost:hover {
            background: #f1f1f1;
        }

    .role-pill {
        background: #f6f7f9;
        border-radius: 20px;
        padding: 5px 10px;
        font-size: 12px;
        font-weight: 500;
    }

    .status-pill {
        border-radius: 20px;
        padding: 5px 10px;
        font-size: 12px;
        font-weight: 500;
    }

    .status-active {
        background: #111;
        color: #fff;
    }

    .status-pending {
        background: #f6f7f9;
        color: #555;
    }

    thead {
        background: #fafafa;
    }

    th {
        font-weight: 600;
        font-size: 14px;
    }

    tbody tr:hover {
        background: #f9f9fb;
    }

    td {
        vertical-align: middle;
        font-size: 14px;
    }

    .avatar {
        width: 34px;
        height: 34px;
        border-radius: 50%;
        background: #111;
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 13px;
        font-weight: 600;
    }

    .search-box {
        max-width: 320px;
    }

</style>


<div class="page-card">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <h4 class="mb-0">Корисници</h4>

        <a asp-action="Create" class="btn btn-primary-custom">
            + Додади корисник
        </a>

    </div>
    
    <div class="mb-4">
        <input type="text"
               id="searchInput"
               class="form-control search-box"
               placeholder="Пребарај корисници..." />
    </div>

    <table class="table align-middle">

        <thead>
            <tr>
                <th></th>
                <th>Е-пошта</th>
                <th>Име</th>
                <th>Улога</th>
                <th>Статус</th>
                <th class="text-end">Акции</th>
            </tr>
        </thead>

        <tbody id="customerTable">

            @foreach (var user in Model)
            {
                <tr>

                    <td>
                        <div class="avatar">
                            @user.Email.Substring(0, 1).ToUpper()
                        </div>
                    </td>

                    <td>@user.Email</td>

                    <td>
                        @(string.IsNullOrWhiteSpace(user.FullName) ? "-" : user.FullName)
                    </td>

                    <td>
                        <span class="role-pill">
                            @user.Role
                        </span>
                    </td>

                    <td>

                        @if (user.IsInviteAccepted)
                        {
                            <span class="status-pill status-active">
                                Активен
                            </span>
                        }
                        else
                        {
                            <span class="status-pill status-pending">
                                Поканата е отворена
                            </span>
                        }

                    </td>

                    <td class="text-end">

                        <a asp-action="Edit"
                               asp-route-id="@user.Id"
                               class="btn btn-ghost me-2">
                            Измени
                        </a>

                        @if (!user.IsInviteAccepted)
                        {
                            <form asp-action="ResendInvite"
                                  method="post"
                                  class="d-inline">

                                <input type="hidden"
                                       name="id"
                                       value="@user.Id" />

                                <button class="btn btn-ghost me-2">
                                    Испрати покана
                                </button>

                            </form>
                        }

                        <a asp-action="Delete"
                               asp-route-id="@user.Id"
                               class="btn btn-ghost">
                            Избриши
                        </a>

                    </td>

                </tr>
            }

        </tbody>

    </table>

</div>


@section Scripts {

    <script>

        const searchInput = document.getElementById("searchInput");
        const rows = document.querySelectorAll("#customerTable tr");

        searchInput.addEventListener("keyup", function () {

            const value = this.value.toLowerCase();

            rows.forEach(row => {

                const text = row.innerText.toLowerCase();

                row.style.display = text.includes(value) ? "" : "none";

            });

        });

    </script>

}