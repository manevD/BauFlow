@model IEnumerable<BauFlow.Entities.ApplicationUser>

@{
    ViewData["Title"] = "Benutzer";
}

<style>

    .page-card {
        background: #ffffff;
        border: 1px solid #eceef2;
        border-radius: 20px;
        box-shadow: 0 8px 24px rgba(0,0,0,.04);
        padding: 30px;
    }

    .btn-dark-custom {
        background: #111;
        border: none;
        color: #fff;
        border-radius: 12px;
        font-weight: 600;
        padding: 8px 14px;
        font-size: 14px;
    }

        .btn-dark-custom:hover {
            background: #000;
            color: #fff;
        }

    .btn-light-custom {
        background: #f1f3f5;
        border: none;
        border-radius: 10px;
        font-size: 13px;
        padding: 6px 12px;
    }

        .btn-light-custom:hover {
            background: #e9ecef;
        }

    .btn-danger-custom {
        background: #fff0f0;
        border: none;
        color: #dc3545;
        border-radius: 10px;
        font-size: 13px;
        padding: 6px 12px;
    }

        .btn-danger-custom:hover {
            background: #ffe5e5;
        }

    .badge-role {
        background: #f1f3f5;
        color: #333;
        padding: 6px 10px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 500;
    }

    table {
        margin-top: 20px;
    }

    thead {
        background: #f8f9fa;
    }

    th {
        font-weight: 600;
        font-size: 14px;
    }

    tbody tr:hover {
        background: #f6f7f9;
    }

    td {
        vertical-align: middle;
        font-size: 14px;
    }

</style>

<div class="page-card">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="mb-0">Benutzer</h4>

        <a asp-action="Create" class="btn btn-dark-custom">
            + Neuer Benutzer
        </a>
    </div>

    <table class="table align-middle">

        <thead>
            <tr>
                <th>Email</th>
                <th>Name</th>
                <th>Rolle</th>
                <th class="text-end">Aktionen</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var user in Model)
            {
                <tr>
                    <td>@user.Email</td>

                    <td>
                        @(string.IsNullOrWhiteSpace(user.FullName) ? "-" : user.FullName)
                    </td>

                    <td>
                        <span class="badge-role">
                            @user.Role
                        </span>
                    </td>

                    <td class="text-end">

                        <a asp-action="Details"
                           asp-route-id="@user.Id"
                           class="btn btn-light-custom me-2">
                            Details
                        </a>

                        <a asp-action="Edit"
                           asp-route-id="@user.Id"
                           class="btn btn-light-custom me-2">
                            Edit
                        </a>

                        <a asp-action="DeleteConfirmed"
                           asp-route-id="@user.Id"
                           class="btn btn-danger-custom">
                            Delete
                        </a>

                    </td>
                </tr>
            }
        </tbody>

    </table>

</div>