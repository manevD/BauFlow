@using BauFlow.ViewModels
@model SetPasswordViewModel

<style>

    .profile-card {
        background: #ffffff;
        border: 1px solid #eceef2;
        border-radius: 20px;
        box-shadow: 0 8px 24px rgba(0,0,0,.04);
        padding: 35px;
        width: 100%;
        max-width: 500px;
    }

    .form-control {
        background: #ffffff;
        border: 1px solid #e2e5ea;
        border-radius: 14px;
    }

        .form-control:focus {
            border-color: #111;
            box-shadow: 0 0 0 3px rgba(0,0,0,.05);
        }

    .btn-primary {
        background: #111 !important;
        border: none !important;
        border-radius: 14px;
        font-weight: 600;
    }

        .btn-primary:hover {
            background: #000 !important;
        }

    .info-box {
        background: #f6f7f9;
        border-radius: 12px;
        padding: 14px;
        font-size: 14px;
        color: #555;
        margin-bottom: 20px;
    }

</style>

<div class="d-flex justify-content-center">

    <div class="profile-card">

        <h4 class="mb-4 text-center">Passwort festlegen</h4>

        <div class="info-box">
            Bitte lege ein sicheres Passwort für dein BauFlow Konto fest.
        </div>

        <form asp-action="SetPassword" method="post">

            <input type="hidden" asp-for="UserId" />
            <input type="hidden" asp-for="Token" />

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3 text-center"></div>

            <div class="form-floating mb-3">
                <input asp-for="Password"
                       class="form-control"
                       placeholder="Passwort" />
                <label asp-for="Password">Passwort</label>
                <span asp-validation-for="Password"
                      class="text-danger small"></span>
            </div>

            <div class="form-floating mb-4">
                <input asp-for="ConfirmPassword"
                       class="form-control"
                       placeholder="Passwort bestätigen" />
                <label asp-for="ConfirmPassword">Passwort bestätigen</label>
                <span asp-validation-for="ConfirmPassword"
                      class="text-danger small"></span>
            </div>

            <button type="submit"
                    class="btn btn-primary w-100 btn-lg">
                Passwort speichern
            </button>

        </form>

    </div>

</div>